---
import Analytics from '@vercel/analytics/astro';
import { createClient } from '@libsql/client';
import { formatearFecha, generarSlug, crearGoogleCalendarUrl, crearWhatsAppShareUrl } from '../../utils/carreras';

const { slug } = Astro.params;

const ahora = new Date();
const hoy = ahora.toISOString().split('T')[0];

const tursoUrl = import.meta.env.TURSO_DATABASE_URL;
const tursoToken = import.meta.env.TURSO_AUTH_TOKEN;

let carrera = null;
let proximasCarreras = [];

if (tursoUrl && tursoToken) {
  try {
    const db = createClient({ url: tursoUrl, authToken: tursoToken });
    const { rows } = await db.execute({
      sql: 'SELECT titulo, fecha, ubicacion, imagen, url_inscripcion, url_ficha, origen, latitud, longitud FROM carreras WHERE fecha >= ? ORDER BY fecha ASC',
      args: [hoy]
    });
    
    // Buscar la carrera que coincida con el slug
    carrera = rows.find((r) => generarSlug(r.titulo as string, r.fecha as string) === slug);
    
    // Si no se encuentra exacta con año, buscar solo con título
    if (!carrera) {
      carrera = rows.find((r) => generarSlug(r.titulo as string) === slug);
    }

    if (carrera) {
      proximasCarreras = rows
        .filter((r) => r.titulo !== carrera.titulo)
        .slice(0, 3);
    }
  } catch (error) {
    console.error('Error al consultar Turso en [slug].astro:', error);
  }
}

if (!carrera) {
  return Astro.redirect('/');
}

const fechaInfo = formatearFecha(carrera.fecha as string);
const calUrl = crearGoogleCalendarUrl(carrera as any);
const waUrl = crearWhatsAppShareUrl(carrera as any, slug);
const mapsUrl = carrera.latitud && carrera.longitud
  ? `https://www.google.com/maps/search/?api=1&query=${carrera.latitud},${carrera.longitud}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${carrera.ubicacion}, Región de Murcia, España`)}`;

// Previsión meteorológica si está dentro de 14 días
const interpretarClima = (code: number) => {
  if (code === 0) return { texto: 'Despejado', icono: '☀️' };
  if ([1, 2, 3].includes(code)) return { texto: 'Intervalos nubosos', icono: '⛅' };
  if ([45, 48].includes(code)) return { texto: 'Niebla', icono: '🌫️' };
  if ([51, 53, 55, 61, 63, 65, 80, 81, 82].includes(code)) return { texto: 'Lluvia', icono: '🌧️' };
  if ([71, 73, 75, 85, 86].includes(code)) return { texto: 'Nieve', icono: '🌨️' };
  if ([95, 96, 99].includes(code)) return { texto: 'Tormenta', icono: '⛈️' };
  return { texto: 'Nublado', icono: '☁️' };
};

let clima = null;
const diasHastaCarrera = Math.floor((new Date(carrera.fecha as string).getTime() - ahora.getTime()) / (1000 * 60 * 60 * 24));

if (diasHastaCarrera >= 0 && diasHastaCarrera <= 14 && carrera.latitud && carrera.longitud) {
  try {
    const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${carrera.latitud}&longitude=${carrera.longitud}&daily=weathercode,temperature_2m_max,temperature_2m_min,precipitation_probability_max,windspeed_10m_max&timezone=Europe%2FMadrid&forecast_days=16`);
    if (res.ok) {
      const data = await res.json();
      const daily = data.daily;
      if (daily?.time) {
        const index = daily.time.findIndex((t: string) => t === carrera.fecha);
        if (index !== -1) {
          const info = interpretarClima(daily.weathercode[index]);
          clima = {
            tempMax: Math.round(daily.temperature_2m_max[index]),
            tempMin: Math.round(daily.temperature_2m_min[index]),
            lluvia: daily.precipitation_probability_max[index] ?? 0,
            viento: Math.round(daily.windspeed_10m_max[index] ?? 0),
            texto: info.texto,
            icono: info.icono
          };
        }
      }
    }
  } catch (e) {
    console.error('Error al obtener clima de la carrera:', e);
  }
}

const urlPagina = `https://carreras-murcia.vercel.app/carrera/${slug}`;
const tituloSEO = `${carrera.titulo} (${fechaInfo.completa}) — Calendario Murcia Running`;
const descripcionSEO = `Toda la información sobre ${carrera.titulo}: fecha (${fechaInfo.completa}), ubicación (${carrera.ubicacion}), previsión meteorológica, mapa e inscripciones oficiales.`;
const imagenSEO = carrera.imagen || 'https://carreras-murcia.vercel.app/assets/og-image.png';

const schemaEvent = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": carrera.titulo,
  "description": descripcionSEO,
  "startDate": `${carrera.fecha}T09:00:00+02:00`,
  "endDate": `${carrera.fecha}T14:00:00+02:00`,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": carrera.ubicacion || "Región de Murcia",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": carrera.ubicacion || "Murcia",
      "addressRegion": "Región de Murcia",
      "addressCountry": "ES"
    },
    ...(carrera.latitud && carrera.longitud ? {
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": Number(carrera.latitud),
        "longitude": Number(carrera.longitud)
      }
    } : {})
  },
  "image": [imagenSEO],
  "organizer": {
    "@type": "Organization",
    "name": carrera.origen || "Calendario Murcia Running",
    "url": "https://carreras-murcia.vercel.app"
  },
  ...(carrera.url_inscripcion ? {
    "offers": {
      "@type": "Offer",
      "url": carrera.url_inscripcion,
      "price": "0",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": hoy
    }
  } : {})
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tituloSEO}</title>
    <meta name="description" content={descripcionSEO} />
    <link rel="canonical" href={urlPagina} />

    <!-- Google Structured Data / Rich Snippets -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaEvent)} />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:title" content={tituloSEO} />
    <meta property="og:description" content={descripcionSEO} />
    <meta property="og:image" content={imagenSEO} />
    <meta property="og:site_name" content="Calendario Murcia Running" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={urlPagina} />
    <meta name="twitter:title" content={tituloSEO} />
    <meta name="twitter:description" content={descripcionSEO} />
    <link rel="icon" type="image/png" href="/assets/logo-removedbg.png" />
    <link rel="apple-touch-icon" href="/assets/logo-removedbg.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Murcia Running" />
    <meta name="application-name" content="Murcia Running" />
    <meta name="theme-color" content="#121315" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <style>
      :root { --ink:#121315; --acid:#ff5a1f; --paper:#f4f1ea; --mist:#d8d7d1; --line:rgba(18,19,21,.22); }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } a { color:inherit; }
      .header-detail { padding:1.25rem clamp(1.1rem,4vw,4rem); display:flex; justify-content:space-between; align-items:center; background:var(--ink); color:var(--paper); font:500 .7rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.06em; }
      .brand { font:1rem/1 'Archivo Black',sans-serif; text-decoration:none; letter-spacing:-.06em; display:inline-flex; align-items:center; gap:.4rem; }
      .brand span { color:var(--acid); }
      .back-link { text-decoration:none; border-bottom:1px solid var(--acid); padding-bottom:2px; color:var(--paper); transition:opacity .18s; }
      .back-link:hover { opacity:.7; }
      
      main { padding:clamp(2.5rem,5vw,5rem) clamp(1.1rem,4vw,4rem); max-width:1400px; margin:auto; }
      .race-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr); gap:clamp(2rem,5vw,4rem); align-items:start; }
      .kicker-line { display:flex; align-items:center; gap:.85rem; flex-wrap:wrap; font:500 .72rem 'DM Mono',monospace; color:var(--acid); text-transform:uppercase; letter-spacing:.08em; }
      .kicker-line .badge { background:rgba(18,19,21,.08); padding:.25rem .55rem; color:var(--ink); border:1px solid var(--line); }
      
      h1 { font:clamp(2.6rem,6vw,5.5rem)/.85 'Archivo Black',sans-serif; letter-spacing:-.08em; text-transform:uppercase; margin:1rem 0 1.25rem; }
      
      .hero-countdown { display:inline-flex; align-items:center; gap:.35rem; margin-bottom:1.5rem; padding:.35rem .75rem; background:var(--ink); border:1px solid var(--acid); color:var(--paper); font:500 .75rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.05em; border-radius:2px; }
      .cd-label { color:var(--acid); font-weight:700; margin-right:.25rem; font-size:.7rem; }
      .cd-segment strong { font-family:'Archivo Black',sans-serif; font-size:1.05rem; color:#ffffff; }
      .cd-sep { color:var(--acid); font-weight:700; }

      .meta-box-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(12rem,1fr)); gap:1rem; margin-bottom:2rem; }
      .meta-box { background:rgba(18,19,21,.04); border:1px solid var(--line); padding:1.1rem 1.25rem; }
      .meta-box span { display:block; font:500 .68rem 'DM Mono',monospace; color:#5b5d5a; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.35rem; }
      .meta-box strong { font-size:1.15rem; font-weight:700; line-height:1.2; color:var(--ink); }

      .actions-container { display:flex; flex-direction:column; gap:.85rem; margin-top:2rem; }
      .main-buttons-grid { display:flex; flex-direction:column; gap:.65rem; }
      .btn-main { display:flex; align-items:center; justify-content:center; gap:.6rem; padding:1.15rem 1.5rem; font:700 .85rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.05em; text-decoration:none; transition:.2s; }
      .btn-main.primary { background:var(--acid); color:var(--ink); border:2px solid var(--acid); font-size:.95rem; }
      .btn-main.primary:hover { background:var(--ink); color:var(--acid); border-color:var(--ink); }
      .btn-main.info-btn { background:var(--ink); color:var(--paper); border:2px solid var(--ink); font-size:.9rem; }
      .btn-main.info-btn:hover { background:transparent; color:var(--ink); }
      .btn-group-secondary { display:grid; grid-template-columns:repeat(auto-fit,minmax(10rem,1fr)); gap:.65rem; }
      .btn-secondary { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; padding:.85rem 1rem; border:1px solid var(--ink); text-decoration:none; font:500 .72rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.04em; transition:.18s; background:transparent; color:var(--ink); }
      .btn-secondary:hover { background:var(--ink); color:var(--paper); }
      .btn-secondary.wa { border-color:#25d366; color:#128c7e; }
      .btn-secondary.wa:hover { background:#25d366; color:var(--ink); }

      .poster-card { background:#292a2b; border:1px solid var(--ink); overflow:hidden; position:relative; }
      .poster-card img { width:100%; height:auto; display:block; object-fit:cover; max-height:36rem; }
      .poster-empty { min-height:20rem; display:grid; place-items:center; background:#d8d7d1; border:1px solid var(--ink); color:#5b5d5a; font:500 .8rem 'DM Mono',monospace; text-transform:uppercase; text-align:center; padding:2rem; }
      .poster-empty i { font-size:3rem; margin-bottom:.75rem; color:var(--acid); }

      .weather-card { margin-top:1.5rem; padding:1.25rem; background:var(--ink); color:var(--paper); border:1px solid var(--ink); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:1rem; }
      .weather-head { display:flex; align-items:center; gap:.8rem; }
      .weather-head .icon { font-size:2rem; }
      .weather-head .temp { font:700 2rem 'Archivo Black',sans-serif; color:var(--acid); line-height:1; }
      .weather-meta { display:flex; gap:1rem; font:500 .72rem 'DM Mono',monospace; text-transform:uppercase; color:#c3c3bd; }

      .map-card { margin-top:3.5rem; border-top:2px solid var(--ink); padding-top:2.5rem; }
      .map-card-head { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:1.2rem; flex-wrap:wrap; gap:1rem; }
      .map-card-head h2 { font:clamp(1.8rem,4vw,3rem)/.9 'Archivo Black',sans-serif; text-transform:uppercase; margin:0; }
      #single-race-map { height:26rem; background:#d8d7d1; border:1px solid var(--ink); }

      .related-section { margin-top:4rem; padding-top:2.5rem; border-top:2px solid var(--ink); }
      .related-section h3 { font:1.8rem 'Archivo Black',sans-serif; text-transform:uppercase; margin:0 0 1.5rem; }
      .related-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(18rem,1fr)); gap:1.25rem; }
      .related-card { border:1px solid var(--line); padding:1.25rem; background:rgba(18,19,21,.02); text-decoration:none; transition:.18s; display:flex; flex-direction:column; justify-content:space-between; gap:1rem; }
      .related-card:hover { background:var(--acid); color:var(--ink); border-color:var(--acid); }
      .related-title { font-weight:700; font-size:1.15rem; margin:0; line-height:1.2; }
      .related-meta { font:500 .7rem 'DM Mono',monospace; text-transform:uppercase; color:#5b5d5a; }
      .related-card:hover .related-meta { color:var(--ink); font-weight:700; }

      .footer { padding:1.5rem clamp(1.1rem,4vw,4rem); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.2rem; background:var(--acid); color:var(--ink); font:500 .68rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.06em; margin-top:5rem; }
      .footer-brand { display:flex; align-items:center; flex-wrap:wrap; gap:1rem clamp(1rem,2vw,2.5rem); }
      .footer-tagline { opacity:.85; }
      .footer-links { display:flex; align-items:center; gap:1.2rem; }
      .footer-link { display:inline-flex; align-items:center; gap:.45rem; color:var(--ink); text-decoration:none; font-weight:700; border-bottom:1px solid var(--ink); padding-bottom:2px; transition:opacity .18s; }
      .footer-link:hover { opacity:.65; }

      .scroll-top-btn { position:fixed; bottom:2rem; right:2rem; width:3rem; height:3rem; background:var(--ink); color:var(--paper); border:2px solid var(--acid); display:flex; align-items:center; justify-content:center; font:700 1.25rem 'Archivo Black',sans-serif; cursor:pointer; z-index:99; opacity:0; visibility:hidden; transform:translateY(12px); transition:all .22s ease; box-shadow:0 6px 18px rgba(0,0,0,.25); }
      .scroll-top-btn.visible { opacity:1; visibility:visible; transform:translateY(0); }
      .scroll-top-btn:hover { background:var(--acid); color:var(--ink); border-color:var(--ink); }

      @media (max-width:850px) {
        .race-hero { grid-template-columns:1fr; }
        .meta-box-grid { grid-template-columns:1fr; }
        .footer { flex-direction:column; align-items:flex-start; }
        .scroll-top-btn { bottom:1.25rem; right:1.25rem; width:2.65rem; height:2.65rem; font-size:1.05rem; }
      }
    </style>
  </head>
  <body>
    <header class="header-detail">
      <a class="brand" href="/">← CALENDARIO<span>/</span>MURCIA<span>/</span>RUNNING</a>
      <a class="back-link" href="/#calendario">Ver calendario completo ↗</a>
    </header>

    <main>
      <div class="race-hero">
        <div class="hero-left">
          <div class="kicker-line">
            <span>Región de Murcia</span>
            <span class="badge">{carrera.origen || 'Agenda Murcia'}</span>
          </div>

          <h1>{carrera.titulo}</h1>

          <div class="hero-countdown" data-date={carrera.fecha}>
            <span class="cd-label">⏳ FALTAN</span>
            <span class="cd-segment"><strong id="cd-days">--</strong>d</span>
            <span class="cd-sep">:</span>
            <span class="cd-segment"><strong id="cd-hours">--</strong>h</span>
            <span class="cd-sep">:</span>
            <span class="cd-segment"><strong id="cd-mins">--</strong>m</span>
            <span class="cd-sep">:</span>
            <span class="cd-segment"><strong id="cd-secs">--</strong>s</span>
          </div>

          <div class="meta-box-grid">
            <div class="meta-box">
              <span>Fecha del evento</span>
              <strong>{fechaInfo.completa}</strong>
            </div>
            <div class="meta-box">
              <span>Ubicación</span>
              <strong>{carrera.ubicacion}</strong>
            </div>
          </div>

          <div class="actions-container">
            <div class="main-buttons-grid">
              {carrera.url_inscripcion && (
                <a class="btn-main primary" href={carrera.url_inscripcion} target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-ticket-perforated"></i> Inscripciones Oficiales ↗
                </a>
              )}
              {carrera.url_ficha && (
                <a class="btn-main info-btn" href={carrera.url_ficha} target="_blank" rel="noopener noreferrer">
                  <i class="bi bi-info-circle"></i> Información y Reglamento ↗
                </a>
              )}
            </div>

            <div class="btn-group-secondary">
              <a class="btn-secondary" href={calUrl} target="_blank" rel="noopener noreferrer" title="Añadir a Google Calendar">
                <i class="bi bi-calendar-plus"></i> + Google Calendar
              </a>
              <a class="btn-secondary wa" href={waUrl} target="_blank" rel="noopener noreferrer" title="Compartir en WhatsApp">
                <i class="bi bi-whatsapp"></i> Compartir
              </a>
              <a class="btn-secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer" title="Ver municipio en Google Maps">
                <i class="bi bi-geo-alt"></i> Ver en Maps
              </a>
            </div>
          </div>

          {clima && (
            <div class="weather-card">
              <div class="weather-head">
                <span class="icon">{clima.icono}</span>
                <div>
                  <div class="temp">{clima.tempMax}°C <small style="font-size:1.1rem;font-weight:400;color:#afafa9;">/ {clima.tempMin}°C</small></div>
                  <div style="font:500 .72rem 'DM Mono',monospace;color:var(--acid);text-transform:uppercase;">Previsión día de carrera ({clima.texto})</div>
                </div>
              </div>
              <div class="weather-meta">
                <span>💧 {clima.lluvia}% Lluvia</span>
                <span>💨 {clima.viento} km/h Viento</span>
              </div>
            </div>
          )}
        </div>

        <div class="hero-right">
          {carrera.imagen ? (
            <div class="poster-card">
              <img src={carrera.imagen} alt={`Cartel oficial de ${carrera.titulo}`} />
            </div>
          ) : (
            <div class="poster-empty">
              <div>
                <i class="bi bi-flag-fill"></i>
                <p>Cartel en proceso de publicación</p>
              </div>
            </div>
          )}
        </div>
      </div>

      {carrera.latitud && carrera.longitud && (
        <section class="map-card">
          <div class="map-card-head">
            <div>
              <span style="font:500 .7rem 'DM Mono',monospace;color:var(--acid);text-transform:uppercase;">Localidad / Municipio</span>
              <h2>En el mapa.</h2>
            </div>
            <a class="btn-secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              Ver municipio en Google Maps ↗
            </a>
          </div>
          <div id="single-race-map"></div>
        </section>
      )}

      {proximasCarreras.length > 0 && (
        <section class="related-section">
          <h3>Otras carreras próximas en la Región</h3>
          <div class="related-grid">
            {proximasCarreras.map((r) => {
              const f = formatearFecha(r.fecha as string);
              const rSlug = generarSlug(r.titulo as string, r.fecha as string);
              return (
                <a href={`/carrera/${rSlug}`} class="related-card">
                  <div>
                    <span class="related-meta">{f.completa} · {r.ubicacion}</span>
                    <p class="related-title">{r.titulo}</p>
                  </div>
                  <span style="font:700 .72rem 'DM Mono',monospace;text-transform:uppercase;">Ver Ficha ↗</span>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </main>

    <footer class="footer">
      <div class="footer-brand">
        <span>CALENDARIO/MURCIA/RUNNING © {new Date().getFullYear()}</span>
        <span class="footer-tagline">Tu próximo kilómetro empieza aquí.</span>
      </div>
      <div class="footer-links">
        <a class="footer-link" href="https://instagram.com/calendariomurciarunning/" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Instagram">
          <i class="bi bi-instagram"></i> Instagram
        </a>
      </div>
    </footer>
    <button id="scroll-top" class="scroll-top-btn" aria-label="Volver arriba" title="Volver al principio">↑</button>

    <Analytics />

    {carrera.latitud && carrera.longitud && (
      <>
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script define:vars={{ lat: Number(carrera.latitud), lon: Number(carrera.longitud), titulo: carrera.titulo, ubicacion: carrera.ubicacion }}>
          const mapElement = document.getElementById('single-race-map');
          if (mapElement) {
            const map = L.map('single-race-map', { scrollWheelZoom: false }).setView([lat, lon], 13);
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap' }).addTo(map);
            L.circleMarker([lat, lon], { radius: 9, color: '#121315', weight: 2, fillColor: '#ff5a1f', fillOpacity: 1 })
              .addTo(map)
              .bindPopup(`<strong>${titulo}</strong><br/>${ubicacion}`)
              .openPopup();
          }
        </script>
      </>
    )}

    <script>
      // --- Cuenta Atrás ---
      const countdownEl = document.querySelector('.hero-countdown');
      if (countdownEl) {
        const targetDateStr = countdownEl.getAttribute('data-date');
        if (targetDateStr) {
          const [year, month, day] = targetDateStr.split('-').map(Number);
          const targetTime = new Date(year, month - 1, day, 9, 0, 0).getTime();
          const cdDays = document.getElementById('cd-days');
          const cdHours = document.getElementById('cd-hours');
          const cdMins = document.getElementById('cd-mins');
          const cdSecs = document.getElementById('cd-secs');

          const updateCountdown = () => {
            const now = new Date().getTime();
            const diff = targetTime - now;

            if (diff <= 0) {
              if (cdDays) cdDays.textContent = '00';
              if (cdHours) cdHours.textContent = '00';
              if (cdMins) cdMins.textContent = '00';
              if (cdSecs) cdSecs.textContent = '00';
              const label = countdownEl.querySelector('.cd-label');
              if (label) label.textContent = '¡HOY ES LA CARRERA!';
              return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const secs = Math.floor((diff % (1000 * 60)) / 1000);

            if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
            if (cdHours) cdHours.textContent = String(hours).padStart(2, '0');
            if (cdMins) cdMins.textContent = String(mins).padStart(2, '0');
            if (cdSecs) cdSecs.textContent = String(secs).padStart(2, '0');
          };

          updateCountdown();
          setInterval(updateCountdown, 1000);
        }
      }

      // --- Volver Arriba ---
      const scrollTopBtn = document.getElementById('scroll-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 350) {
          scrollTopBtn?.classList.add('visible');
        } else {
          scrollTopBtn?.classList.remove('visible');
        }
      }, { passive: true });

      scrollTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>

