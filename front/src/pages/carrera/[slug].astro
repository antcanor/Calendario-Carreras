---
import Base from '../../layouts/Base.astro';
import { createClient } from '@libsql/client';
import { formatearFecha, generarSlug, crearGoogleCalendarUrl, crearWhatsAppShareUrl, formatearDistancias, formatearPrecio } from '../../utils/carreras';
import { obtenerClima } from '../../utils/clima';

const { slug } = Astro.params;

const ahora = new Date();
const hoy = ahora.toISOString().split('T')[0];

const tursoUrl = import.meta.env.TURSO_DATABASE_URL;
const tursoToken = import.meta.env.TURSO_AUTH_TOKEN;

let carrera = null;
let proximasCarreras = [];

if (tursoUrl && tursoToken) {
  try {
    const db = createClient({ url: tursoUrl, authToken: tursoToken });
    const { rows } = await db.execute({
      sql: 'SELECT titulo, fecha, ubicacion, imagen, url_inscripcion, url_ficha, origen, latitud, longitud, modalidad, distancias, precio_min, precio_max FROM carreras WHERE fecha >= ? ORDER BY fecha ASC',
      args: [hoy]
    });
    
    // Buscar la carrera que coincida con el slug
    carrera = rows.find((r) => generarSlug(r.titulo as string, r.fecha as string) === slug);
    
    // Si no se encuentra exacta con año, buscar solo con título
    if (!carrera) {
      carrera = rows.find((r) => generarSlug(r.titulo as string) === slug);
    }

    if (carrera) {
      proximasCarreras = rows
        .filter((r) => r.titulo !== carrera.titulo)
        .slice(0, 3);
    }
  } catch (error) {
    console.error('Error al consultar Turso en [slug].astro:', error);
  }
}

if (!carrera) {
  return Astro.redirect('/');
}

const fechaInfo = formatearFecha(carrera.fecha as string);
const calUrl = crearGoogleCalendarUrl(carrera as any);
const waUrl = crearWhatsAppShareUrl(carrera as any, slug);
const mapsUrl = carrera.latitud && carrera.longitud
  ? `https://www.google.com/maps/search/?api=1&query=${carrera.latitud},${carrera.longitud}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${carrera.ubicacion}, Región de Murcia, España`)}`;

const clima = await obtenerClima(carrera.latitud, carrera.longitud, carrera.fecha as string, 4000);
const tieneMapa = carrera.latitud != null && carrera.longitud != null;

const distanciasTexto = formatearDistancias(carrera.distancias);
const precioTexto = formatearPrecio(carrera.precio_min, carrera.precio_max, true);

const urlPagina = `https://carreras-murcia.vercel.app/carrera/${slug}`;
const tituloSEO = `${carrera.titulo} (${fechaInfo.completa}) — Calendario Murcia Running`;
const descripcionSEO = `Toda la información sobre ${carrera.titulo}: fecha (${fechaInfo.completa}), ubicación (${carrera.ubicacion}), previsión meteorológica, mapa e inscripciones oficiales.`;
const imagenSEO = carrera.imagen || 'https://carreras-murcia.vercel.app/assets/og-image.png';

const schemaEvent = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": carrera.titulo,
  "description": descripcionSEO,
  "startDate": `${carrera.fecha}T09:00:00+02:00`,
  "endDate": `${carrera.fecha}T14:00:00+02:00`,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": carrera.ubicacion || "Región de Murcia",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": carrera.ubicacion || "Murcia",
      "addressRegion": "Región de Murcia",
      "addressCountry": "ES"
    },
    ...(carrera.latitud && carrera.longitud ? {
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": Number(carrera.latitud),
        "longitude": Number(carrera.longitud)
      }
    } : {})
  },
  "image": [imagenSEO],
  "organizer": {
    "@type": "Organization",
    "name": carrera.origen || "Calendario Murcia Running",
    "url": "https://carreras-murcia.vercel.app"
  },
  ...(carrera.url_inscripcion ? {
    "offers": {
      "@type": "Offer",
      "url": carrera.url_inscripcion,
      "price": String(carrera.precio_min ?? 0),
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": hoy
    }
  } : {})
};
---

<Base titulo={tituloSEO} descripcion={descripcionSEO} canonical={urlPagina} imagen={imagenSEO} ogType="article" schema={schemaEvent}>
  <main class="ficha contenedor">
    <a class="ficha-volver" href="/#calendario"><i class="bi bi-arrow-left" aria-hidden="true"></i> Todas las carreras</a>

    <div class="ficha-rejilla">
      <div>
        <p class="ficha-fecha">{fechaInfo.larga}</p>
        <h1>{carrera.titulo}</h1>
        <p class="ficha-lugar"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> {carrera.ubicacion}</p>

        <div class="ficha-cuenta cuenta" data-cuenta={carrera.fecha}>
          <span>Faltan</span>
          <span class="cuenta-tramo"><strong data-cd="d">--</strong> d</span>
          <span class="cuenta-tramo"><strong data-cd="h">--</strong> h</span>
          <span class="cuenta-tramo"><strong data-cd="m">--</strong> min</span>
          <span class="cuenta-tramo"><strong data-cd="s">--</strong> s</span>
        </div>

        {(carrera.modalidad || distanciasTexto || precioTexto) && (
          <dl class="ficha-datos">
            {carrera.modalidad && <div><dt>Modalidad</dt><dd>{carrera.modalidad}</dd></div>}
            {distanciasTexto && <div><dt>Distancias</dt><dd>{distanciasTexto}</dd></div>}
            {precioTexto && <div><dt>Inscripción</dt><dd>{precioTexto}</dd></div>}
          </dl>
        )}

        <div class="ficha-acciones">
          {carrera.url_inscripcion && (
            <a class="boton boton-principal ficha-grande" href={carrera.url_inscripcion} target="_blank" rel="noopener noreferrer">
              <i class="bi bi-ticket-perforated" aria-hidden="true"></i> Ir a la inscripción
            </a>
          )}
          {carrera.url_ficha && (
            <a class="boton boton-marino ficha-grande" href={carrera.url_ficha} target="_blank" rel="noopener noreferrer">
              <i class="bi bi-file-text" aria-hidden="true"></i> Información y reglamento
            </a>
          )}
          <div class="ficha-secundarias">
            <a class="boton" href={calUrl} target="_blank" rel="noopener noreferrer"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Añadir a Google Calendar</a>
            <a class="boton" href={waUrl} target="_blank" rel="noopener noreferrer"><i class="bi bi-whatsapp" aria-hidden="true"></i> Compartir por WhatsApp</a>
            <a class="boton" href={mapsUrl} target="_blank" rel="noopener noreferrer"><i class="bi bi-map" aria-hidden="true"></i> Abrir en Google Maps</a>
          </div>
        </div>

        {clima && (
          <div class="ficha-clima">
            <i class={`bi ${clima.icono}`} aria-hidden="true"></i>
            <div>
              <p class="ficha-clima-temp"><strong>{clima.tempMax} °C</strong> máx. / {clima.tempMin} °C mín.</p>
              <p>Previsión para el día de la carrera: {clima.texto.toLowerCase()}, {clima.lluvia} % de probabilidad de lluvia y viento de hasta {clima.viento} km/h.</p>
            </div>
          </div>
        )}

        {carrera.origen && <p class="ficha-origen">Datos de {String(carrera.origen).toLowerCase()}. Confirma siempre fecha y horario en la web de la organización.</p>}
      </div>

      <div class="ficha-cartel">
        {carrera.imagen ? (
          <img src={carrera.imagen} alt={`Cartel oficial de ${carrera.titulo}`} />
        ) : (
          <div class="ficha-sin-cartel">
            <i class="bi bi-flag-fill" aria-hidden="true"></i>
            <p>Esta carrera todavía no tiene cartel publicado.</p>
          </div>
        )}
      </div>
    </div>

    {tieneMapa && (
      <section class="ficha-seccion" aria-labelledby="mapa-titulo">
        <h2 id="mapa-titulo">Dónde es</h2>
        <div id="mapa-ficha" class="mapa"></div>
      </section>
    )}

    {proximasCarreras.length > 0 && (
      <section class="ficha-seccion" aria-labelledby="otras-titulo">
        <h2 id="otras-titulo">Otras carreras cerca en el calendario</h2>
        <div class="otras">
          {proximasCarreras.map((r) => {
            const f = formatearFecha(r.fecha as string);
            return (
              <a class="otra" href={`/carrera/${generarSlug(r.titulo as string, r.fecha as string)}`}>
                <span class="otra-fecha"><strong>{f.dia}</strong>{f.mes.toLowerCase()}</span>
                <span>
                  <span class="otra-titulo">{r.titulo}</span>
                  <span class="otra-lugar">{r.ubicacion}</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <Fragment slot="scripts">
    {tieneMapa && (
      <>
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script define:vars={{ lat: Number(carrera.latitud), lon: Number(carrera.longitud), titulo: carrera.titulo, ubicacion: carrera.ubicacion }}>
          const escapar = (valor) => String(valor ?? '').replace(/[&<>'"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[c]);
          const map = L.map('mapa-ficha', { scrollWheelZoom: false }).setView([lat, lon], 13);
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
          L.circleMarker([lat, lon], { radius: 9, color: '#12264a', weight: 2, fillColor: '#ffc91f', fillOpacity: 1 })
            .addTo(map)
            .bindPopup(`<strong class="popup-titulo">${escapar(titulo)}</strong><span class="popup-meta">${escapar(ubicacion)}</span>`)
            .openPopup();
        </script>
      </>
    )}
  </Fragment>
</Base>

<style is:global>
  .ficha { padding-top: 1.5rem; }
  .ficha-volver { display: inline-flex; align-items: center; gap: .45rem; min-height: 2.75rem; font-weight: 600; text-underline-offset: 3px; }
  .ficha-rejilla { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); align-items: start; gap: clamp(2rem, 5vw, 4rem); margin-top: 1rem; }
  .ficha-fecha { display: inline-block; margin: 0; padding: .35rem .8rem; background: var(--sol); border-radius: 6px; font-weight: 700; }
  .ficha-fecha::first-letter { text-transform: uppercase; }
  .ficha h1 { margin: 1rem 0 .75rem; font: 900 clamp(2.4rem, 5.6vw, 4.25rem)/.95 var(--display); text-transform: uppercase; letter-spacing: .005em; text-wrap: balance; overflow-wrap: anywhere; }
  .ficha-lugar { margin: 0; font-size: 1.1rem; color: var(--gris); }
  .ficha-cuenta { display: inline-flex; margin-top: 1.5rem; padding: .7rem 1.1rem; background: var(--marino); color: var(--blanco); border-radius: 8px; }
  .ficha-cuenta .cuenta-tramo strong { color: var(--sol); }
  .ficha-datos { display: flex; flex-wrap: wrap; gap: .75rem 2.25rem; max-width: 36rem; margin: 1.5rem 0 0; padding-top: 1.1rem; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-size: .875rem; color: var(--gris); }
  .ficha-datos dd { margin: 0; font-weight: 700; font-size: 1.05rem; }
  .ficha-acciones { display: grid; gap: .65rem; margin-top: 1.75rem; max-width: 36rem; }
  .ficha-grande { min-height: 3.4rem; font-size: 1.05rem; }
  .ficha-secundarias { display: flex; flex-wrap: wrap; gap: .65rem; }
  .ficha-secundarias .boton { flex: 1 1 auto; }
  .ficha-clima { display: flex; align-items: center; gap: 1.1rem; max-width: 36rem; margin-top: 1.75rem; padding: 1.1rem 1.25rem; background: var(--blanco); border: 1px solid var(--linea); border-radius: 10px; }
  .ficha-clima > i { font-size: 2.4rem; color: var(--marino-2); }
  .ficha-clima p { margin: 0; color: var(--gris); font-size: .94rem; }
  .ficha-clima .ficha-clima-temp { color: var(--marino); font-size: 1rem; }
  .ficha-clima-temp strong { font: 900 1.9rem/1 var(--display); margin-right: .2rem; }
  .ficha-origen { max-width: 36rem; margin: 1.5rem 0 0; font-size: .875rem; color: var(--gris); }
  .ficha-cartel img { display: block; width: 100%; height: auto; border: 2px solid var(--marino); border-radius: 12px; box-shadow: 10px 10px 0 var(--marino); }
  .ficha-sin-cartel { display: grid; place-items: center; align-content: center; gap: .5rem; min-height: 18rem; padding: 2rem; background: #e3e6ee; border-radius: 12px; color: var(--gris); text-align: center; }
  .ficha-sin-cartel i { font-size: 2.5rem; color: var(--marino-2); }
  .ficha-sin-cartel p { margin: 0; }
  .ficha-seccion { margin-top: clamp(3rem, 7vw, 5rem); }
  .ficha-seccion h2 { margin: 0 0 1.25rem; padding-bottom: .6rem; border-bottom: 3px solid var(--marino); font: 900 clamp(1.9rem, 4vw, 2.75rem)/1 var(--display); text-transform: uppercase; letter-spacing: .01em; }
  .otras { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1rem; }
  .otra { display: grid; grid-template-columns: 3.6rem minmax(0, 1fr); align-items: center; gap: 1rem; padding: 1rem; background: var(--blanco); border: 1px solid var(--linea); border-radius: 10px; text-decoration: none; transition: border-color .15s; }
  .otra:hover { border-color: var(--marino); }
  .otra-fecha { display: grid; justify-items: center; padding: .4rem 0; border: 2px solid var(--marino); border-radius: 7px; font-size: .8rem; font-weight: 600; color: var(--carmesi); line-height: 1; }
  .otra-fecha strong { font: 900 1.9rem/.95 var(--display); color: var(--marino); }
  .otra-titulo { display: block; font-weight: 700; line-height: 1.25; }
  .otra-lugar { display: block; margin-top: .2rem; font-size: .9rem; color: var(--gris); }

  @media (max-width: 860px) {
    .ficha-rejilla { grid-template-columns: 1fr; }
    .ficha-cartel { max-width: 26rem; }
    .ficha-cartel img { box-shadow: 6px 6px 0 var(--marino); }
  }
</style>
