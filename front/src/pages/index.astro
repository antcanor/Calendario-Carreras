    <main id="calendario">
      <div class="index-head"><div><span class="label" style="color: var(--ink)">01 / Calendario</span><h2>El próximo<br />dorsal.</h2></div><p class="counter">{carreras.length.toString().padStart(2, '0')} carreras<br />por descubrir</p></div>
      <div class="controls"><label class="visually-hidden" for="race-search">Buscar carrera</label><input class="search" id="race-search" type="search" placeholder="Buscar por carrera o ubicación…" autocomplete="off" /><div class="filters" aria-label="Filtrar calendario"><button class="filter active" data-filter="all">Todo el calendario</button><button class="filter filter-express" data-filter="weekend">⚡ Este Finde</button><button class="filter filter-express" data-filter="15days">🔥 Próximos 15 días</button><button class="filter filter-express" data-filter="30days">📅 Próximo mes (30d)</button>{mesesDisponibles.map((mes) => <button class="filter" data-filter={mes}>{etiquetaMes(mes)}</button>)}</div></div>
      <section class="race-list" aria-label="Listado de carreras">
        {carreras.map((carrera, indice) => { const cuando = fecha(carrera.fecha); const mesFiltro = carrera.fecha.substring(0, 7); const clima = mapaClima.get(carrera.titulo); const slug = generarSlug(carrera.titulo, carrera.fecha); return <article class="race" data-mes={mesFiltro} data-fecha={carrera.fecha} data-search={`${carrera.titulo} ${carrera.ubicacion}`}><div class="date">{cuando.dia}<span>{cuando.mes}</span></div><div class="race-image">{carrera.imagen ? <img src={carrera.imagen} alt="" loading="lazy" /> : <i class="bi bi-flag-fill"></i>}</div><div><p class="race-title">{carrera.titulo}</p><p class="race-place" data-locate={carrera.titulo} title="Ver ubicación en el mapa"><i class="bi bi-geo-alt me-1"></i>{carrera.ubicacion}</p>{clima && <div class="race-weather" title={`Previsión día de carrera: ${clima.texto}, viento ${clima.viento} km/h`}><span class="weather-icon">{clima.icono}</span><span class="weather-temp">{clima.tempMax}°C</span><span class="weather-rain">💧 {clima.lluvia}%</span><span class="weather-wind">💨 {clima.viento} km/h</span></div>}</div><div class="race-meta">#{String(indice + 1).padStart(2, '0')}<br />{carrera.origen || 'Agenda Murcia'}</div><div class="race-links"><a class="action wa-action" href={crearWhatsAppShareUrl(carrera)} target="_blank" rel="noopener noreferrer" aria-label={`Compartir ${carrera.titulo} por WhatsApp`} title="Compartir en WhatsApp"><i class="bi bi-whatsapp"></i></a><a class="action cal-action" href={crearGoogleCalendarUrl(carrera)} target="_blank" rel="noopener noreferrer" aria-label={`Añadir ${carrera.titulo} a Google Calendar`} title="Añadir a Google Calendar"><i class="bi bi-calendar-plus"></i> Cal</a><a class="action primary" href={`/carrera/${slug}`} aria-label={`Ver ficha de ${carrera.titulo}`}>Ficha ↗</a></div></article>; })}
      </section>
      <div class="empty" id="no-results" hidden>No hay carreras con esos criterios. Prueba con otro nombre, ubicación o mes.</div>
      {carreras.length === 0 && <div class="empty">Aún no hay próximas pruebas publicadas. Vuelve pronto.</div>}

      <section class="map-section" id="mapa" aria-labelledby="mapa-title"><div class="map-head"><div><span class="label" style="color: var(--ink)">02 / Mapa</span><h3 id="mapa-title">Corre por<br />el mapa.</h3></div><p>{marcadoresMapa.length ? `${marcadoresMapa.length} carreras ya localizadas. Toca un punto para ver los detalles.` : 'Estamos localizando las próximas carreras para situarlas aquí.'}</p></div>{marcadoresMapa.length ? <div id="race-map" aria-label="Mapa de carreras"></div> : <div class="map-empty"><div><strong>Mapa en preparación</strong>Ejecuta el geocodificador para mostrar las carreras por ubicación.</div></div>}</section>

      <section class="ritmos-section" id="ritmos" aria-labelledby="ritmos-title">
        <div class="index-head"><div><span class="label" style="color: var(--ink)">03 / Calculadora</span><h2 id="ritmos-title">Calcula<br />tu ritmo.</h2></div><p class="counter">Planifica tus marcas<br />y tiempos de paso</p></div>
        <div class="ritmos-grid">
          <div class="ritmos-card">
            <span class="card-kicker">1. Selecciona Distancia</span>
            <div class="dist-buttons">
              <button type="button" class="dist-btn" data-dist="5">5K</button>
              <button type="button" class="dist-btn active" data-dist="10">10K</button>
              <button type="button" class="dist-btn" data-dist="21.0975">21K (Media)</button>
              <button type="button" class="dist-btn" data-dist="42.195">42K (Maratón)</button>
              <button type="button" class="dist-btn" data-dist="custom">Otro km</button>
            </div>
            <div class="custom-dist-wrap" id="custom-dist-wrap" hidden>
              <label for="custom-km">Distancia en kilómetros</label>
              <input type="number" id="custom-km" min="0.1" max="250" step="0.1" value="7.5" placeholder="Ej: 7.5" />
            </div>
            <span class="card-kicker" style="margin-top:1.6rem;">2. Tiempo Objetivo</span>
            <div class="time-inputs">
              <div class="time-field">
                <label for="time-hours">Horas</label>
                <input type="number" id="time-hours" min="0" max="99" value="0" placeholder="00" />
              </div>
              <span class="time-colon">:</span>
              <div class="time-field">
                <label for="time-mins">Minutos</label>
                <input type="number" id="time-mins" min="0" max="59" value="45" placeholder="45" />
              </div>
              <span class="time-colon">:</span>
              <div class="time-field">
                <label for="time-secs">Segundos</label>
                <input type="number" id="time-secs" min="0" max="59" value="0" placeholder="00" />
              </div>
            </div>
          </div>
          <div class="ritmos-card">
            <div class="pace-display">
              <div>
                <span class="pace-label">Ritmo Medio Necesario</span>
                <div class="pace-hero"><span id="pace-min-km">4:30</span> <span class="pace-unit">MIN / KM</span></div>
              </div>
              <div class="speed-box">
                <span class="speed-label">Velocidad Media</span>
                <span class="speed-val" id="pace-speed">13.33 <small>km/h</small></span>
              </div>
            </div>
            <div class="splits-box">
              <span class="card-kicker">Tiempos de Paso Estimados</span>
              <div class="splits-table-wrap">
                <table class="splits-table">
                  <thead>
                    <tr>
                      <th>Punto</th>
                      <th>Tiempo Acumulado</th>
                      <th>Ritmo</th>
                    </tr>
                  </thead>
                  <tbody id="splits-tbody">
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="alerta" id="alertas" aria-labelledby="alerta-title">
        <div class="alerta-content"><span class="label">04 / Alerta mensual</span><h3 id="alerta-title">Tu próximo<br />dorsal, en tu inbox.</h3><p>Una vez al mes: las nuevas carreras de Murcia, fechas que no deberías dejar escapar y nada de ruido.</p></div>
        <form class="alerta-form" id="alerta-form"><label for="alerta-email">Tu email</label><div class="alerta-fields"><input id="alerta-email" name="email" type="email" placeholder="corredor@ejemplo.com" autocomplete="email" required /><button type="submit">Quiero recibirla ↗</button></div><div class="consent"><input id="alerta-consentimiento" name="consentimiento" type="checkbox" required /><label for="alerta-consentimiento">Acepto recibir la alerta mensual de carreras por email.</label></div><p class="form-message" id="alerta-mensaje" role="status" aria-live="polite"></p><small>Una alerta al mes. Puedes darte de baja cuando quieras.</small></form>
      </section>
    </main>
    <footer class="footer">
      <div class="footer-brand">
        <span>CALENDARIO/MURCIA/RUNNING © {new Date().getFullYear()}</span>
        <span class="footer-tagline">Tu próximo kilómetro empieza aquí.</span>
      </div>
      <div class="footer-links">
        <a class="footer-link" href="https://instagram.com/calendariomurciarunning/" target="_blank" rel="noopener noreferrer" aria-label="Síguenos en Instagram">
          <i class="bi bi-instagram"></i> Instagram
        </a>
      </div>
    </footer>
    <Analytics />
    {marcadoresMapa.length > 0 && <><script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script><script define:vars={{ marcadoresMapa }}>
      const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
      const mapElement = document.getElementById('race-map');
      if (mapElement) {
        const map = L.map('race-map', { scrollWheelZoom: false });
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);

        const markerItems = marcadoresMapa.map((carrera) => {
          const point = [carrera.latitud, carrera.longitud];
          const link = carrera.enlace ? `<a class="map-popup-link" target="_blank" rel="noopener noreferrer" href="${escapeHtml(carrera.enlace)}">Ver carrera ↗</a>` : '';
          const calBtn = carrera.calUrl ? `<a class="map-popup-link" target="_blank" rel="noopener noreferrer" href="${escapeHtml(carrera.calUrl)}" style="margin-left:0.75rem;"><i class="bi bi-calendar-plus"></i> + Cal</a>` : '';
          const waBtn = carrera.waUrl ? `<a class="map-popup-link" target="_blank" rel="noopener noreferrer" href="${escapeHtml(carrera.waUrl)}" style="margin-left:0.75rem;color:#128c7e;"><i class="bi bi-whatsapp"></i> WhatsApp</a>` : '';
          const marker = L.circleMarker(point, { radius: 8, color: '#121315', weight: 2, fillColor: '#ff5a1f', fillOpacity: 1 })
            .addTo(map)
            .bindPopup(`<strong class="map-popup-title">${escapeHtml(carrera.titulo)}</strong><span class="map-popup-meta">${escapeHtml(carrera.fechaFormateada)} · ${escapeHtml(carrera.ubicacion)}</span>${link}${calBtn}${waBtn}`);
          return { marker, carrera, point };
        });

        const allPoints = markerItems.map((m) => m.point);
        if (allPoints.length === 1) map.setView(allPoints[0], 12);
        else if (allPoints.length > 1) map.fitBounds(allPoints, { padding: [36, 36], maxZoom: 11 });

        const checkFilterMatch = (dateStr, filterValue) => {
          if (filterValue === 'all') return true;
          if (!dateStr) return false;
          const [y, m, d] = dateStr.split('-').map(Number);
          const raceDate = new Date(y, m - 1, d);
          raceDate.setHours(0, 0, 0, 0);
          const today = new Date();
          today.setHours(0, 0, 0, 0);

          if (filterValue === 'weekend') {
            const dayOfWeek = today.getDay();
            const startWeekend = new Date(today);
            if (dayOfWeek === 6 || dayOfWeek === 0) {
              startWeekend.setDate(today.getDate());
            } else {
              const daysToFriday = (5 - dayOfWeek + 7) % 7;
              startWeekend.setDate(today.getDate() + daysToFriday);
            }
            const endWeekend = new Date(today);
            const daysToSunday = (7 - dayOfWeek) % 7;
            endWeekend.setDate(today.getDate() + daysToSunday);
            endWeekend.setHours(23, 59, 59, 999);
            return raceDate >= startWeekend && raceDate <= endWeekend;
          }

          if (filterValue === '15days') {
            const limit = new Date(today);
            limit.setDate(today.getDate() + 15);
            limit.setHours(23, 59, 59, 999);
            return raceDate >= today && raceDate <= limit;
          }

          if (filterValue === '30days') {
            const limit = new Date(today);
            limit.setDate(today.getDate() + 30);
            limit.setHours(23, 59, 59, 999);
            return raceDate >= today && raceDate <= limit;
          }

          return dateStr.substring(0, 7) === filterValue;
        };

        window.__raceMapController = {
          filterMarkers: (query, selectedFilter) => {
            const norm = (v) => (v || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
            const normQuery = norm(query);
            const visibleBounds = [];

            markerItems.forEach(({ marker, carrera, point }) => {
              const matchesFilter = checkFilterMatch(carrera.fecha, selectedFilter);
              const matchesSearch = !normQuery || norm(carrera.search).includes(normQuery);
              const visible = matchesFilter && matchesSearch;

              if (visible) {
                if (!map.hasLayer(marker)) map.addLayer(marker);
                visibleBounds.push(point);
              } else {
                if (map.hasLayer(marker)) map.removeLayer(marker);
              }
            });

            if (visibleBounds.length === 1) {
              map.setView(visibleBounds[0], 12);
            } else if (visibleBounds.length > 1) {
              map.fitBounds(visibleBounds, { padding: [36, 36], maxZoom: 11 });
            }
          },
          focusRace: (titulo) => {
            const target = markerItems.find((item) => item.carrera.titulo === titulo);
            if (target) {
              if (!map.hasLayer(target.marker)) map.addLayer(target.marker);
              map.flyTo(target.point, 13, { duration: 0.8 });
              setTimeout(() => target.marker.openPopup(), 450);
            }
          }
        };
      }
    </script></>}
    <script>
      const buttons = document.querySelectorAll('.filter');
      const races = document.querySelectorAll('.race');
      const search = document.querySelector('#race-search');
      const empty = document.querySelector('#no-results');
      let selectedFilter = 'all';

      const normalize = (value) => (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

      const checkListFilter = (dateStr, filterValue) => {
        if (filterValue === 'all') return true;
        if (!dateStr) return false;
        const [y, m, d] = dateStr.split('-').map(Number);
        const raceDate = new Date(y, m - 1, d);
        raceDate.setHours(0, 0, 0, 0);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        if (filterValue === 'weekend') {
          const dayOfWeek = today.getDay();
          const startWeekend = new Date(today);
          if (dayOfWeek === 6 || dayOfWeek === 0) {
            startWeekend.setDate(today.getDate());
          } else {
            const daysToFriday = (5 - dayOfWeek + 7) % 7;
            startWeekend.setDate(today.getDate() + daysToFriday);
          }
          const endWeekend = new Date(today);
          const daysToSunday = (7 - dayOfWeek) % 7;
          endWeekend.setDate(today.getDate() + daysToSunday);
          endWeekend.setHours(23, 59, 59, 999);
          return raceDate >= startWeekend && raceDate <= endWeekend;
        }

        if (filterValue === '15days') {
          const limit = new Date(today);
          limit.setDate(today.getDate() + 15);
          limit.setHours(23, 59, 59, 999);
          return raceDate >= today && raceDate <= limit;
        }

        if (filterValue === '30days') {
          const limit = new Date(today);
          limit.setDate(today.getDate() + 30);
          limit.setHours(23, 59, 59, 999);
          return raceDate >= today && raceDate <= limit;
        }

        return dateStr.substring(0, 7) === filterValue;
      };

      const updateList = () => {
        const query = search?.value.trim() || '';
        const normQuery = normalize(query);
        let total = 0;
        races.forEach((race) => {
          const raceDate = race.dataset.fecha || '';
          const matchesFilter = checkListFilter(raceDate, selectedFilter);
          const matchesSearch = !normQuery || normalize(race.dataset.search || '').includes(normQuery);
          const show = matchesFilter && matchesSearch;
          race.hidden = !show;
          if (show) total++;
        });
        if (empty) empty.hidden = total !== 0;
        window.__raceMapController?.filterMarkers(query, selectedFilter);
      };

      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        selectedFilter = button.dataset.filter || 'all';
        updateList();
      }));
      search?.addEventListener('input', updateList);

      document.querySelectorAll('[data-locate]').forEach((placeBtn) => {
        placeBtn.addEventListener('click', (e) => {
          const titulo = placeBtn.getAttribute('data-locate');
          if (titulo) {
            document.querySelector('#mapa')?.scrollIntoView({ behavior: 'smooth' });
            window.__raceMapController?.focusRace(titulo);
          }
        });
      });

      // --- Calculadora de Ritmos ---
      let currentDistance = 10;
      const distButtons = document.querySelectorAll('.dist-btn');
      const customWrap = document.getElementById('custom-dist-wrap');
      const customKmInput = document.getElementById('custom-km');
      const timeHours = document.getElementById('time-hours');
      const timeMins = document.getElementById('time-mins');
      const timeSecs = document.getElementById('time-secs');
      const paceMinKm = document.getElementById('pace-min-km');
      const paceSpeed = document.getElementById('pace-speed');
      const splitsTbody = document.getElementById('splits-tbody');

      const formatTime = (totalSeconds) => {
        const h = Math.floor(totalSeconds / 3600);
        const m = Math.floor((totalSeconds % 3600) / 60);
        const s = Math.round(totalSeconds % 60);
        if (h > 0) {
          return `${h}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
        }
        return `${m}m ${String(s).padStart(2, '0')}s`;
      };

      const formatPace = (secondsPerKm) => {
        const m = Math.floor(secondsPerKm / 60);
        const s = Math.round(secondsPerKm % 60);
        return `${m}:${String(s).padStart(2, '0')}`;
      };

      const calculatePace = () => {
        const h = Math.max(0, parseInt(timeHours?.value, 10) || 0);
        const m = Math.max(0, parseInt(timeMins?.value, 10) || 0);
        const s = Math.max(0, parseInt(timeSecs?.value, 10) || 0);
        const totalSeconds = h * 3600 + m * 60 + s;

        let dist = currentDistance;
        if (currentDistance === 'custom') {
          dist = Math.max(0.1, parseFloat(customKmInput?.value) || 5);
        }

        if (totalSeconds <= 0 || dist <= 0) {
          if (paceMinKm) paceMinKm.textContent = '--:--';
          if (paceSpeed) paceSpeed.innerHTML = `0.00 <small>km/h</small>`;
          if (splitsTbody) splitsTbody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:#747570;padding:1rem;">Introduce un tiempo objetivo</td></tr>';
          return;
        }

        const secondsPerKm = totalSeconds / dist;
        const speedKmH = (dist / (totalSeconds / 3600)).toFixed(2);

        if (paceMinKm) paceMinKm.textContent = formatPace(secondsPerKm);
        if (paceSpeed) paceSpeed.innerHTML = `${speedKmH} <small>km/h</small>`;

        if (splitsTbody) {
          const points = [];
          if (dist <= 5) {
            for (let i = 1; i <= Math.floor(dist); i++) points.push(i);
          } else if (dist <= 10) {
            for (let i = 2; i <= Math.floor(dist); i += 2) points.push(i);
          } else if (dist <= 21.1) {
            points.push(5, 10, 15, 20);
          } else {
            points.push(5, 10, 15, 20, 25, 30, 35, 40);
          }
          if (!points.includes(dist)) points.push(dist);

          splitsTbody.innerHTML = points.map((p) => {
            const splitTime = formatTime(secondsPerKm * p);
            const label = p === dist ? `Meta (${p.toFixed(p % 1 === 0 ? 0 : 2)}k)` : `Km ${p}`;
            return `<tr>
              <td><strong>${label}</strong></td>
              <td style="color:var(--acid);font-weight:700;">${splitTime}</td>
              <td style="color:#afafa9;">${formatPace(secondsPerKm)} /km</td>
            </tr>`;
          }).join('');
        }
      };

      distButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          distButtons.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          const val = btn.dataset.dist;
          if (val === 'custom') {
            currentDistance = 'custom';
            if (customWrap) customWrap.hidden = false;
          } else {
            currentDistance = parseFloat(val);
            if (customWrap) customWrap.hidden = true;
          }
          calculatePace();
        });
      });

      [timeHours, timeMins, timeSecs, customKmInput].forEach((input) => {
        input?.addEventListener('input', calculatePace);
      });
      calculatePace();

      // --- Cuenta Atrás Hero ---
      const countdownEl = document.querySelector('.hero-countdown');
      if (countdownEl) {
        const targetDateStr = countdownEl.getAttribute('data-date');
        if (targetDateStr) {
          const [year, month, day] = targetDateStr.split('-').map(Number);
          const targetTime = new Date(year, month - 1, day, 9, 0, 0).getTime();
          const cdDays = document.getElementById('cd-days');
          const cdHours = document.getElementById('cd-hours');
          const cdMins = document.getElementById('cd-mins');
          const cdSecs = document.getElementById('cd-secs');

          const updateCountdown = () => {
            const now = new Date().getTime();
            const diff = targetTime - now;

            if (diff <= 0) {
              if (cdDays) cdDays.textContent = '00';
              if (cdHours) cdHours.textContent = '00';
              if (cdMins) cdMins.textContent = '00';
              if (cdSecs) cdSecs.textContent = '00';
              const label = countdownEl.querySelector('.cd-label');
              if (label) label.textContent = '¡HOY ES LA CARRERA!';
              return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const secs = Math.floor((diff % (1000 * 60)) / 1000);

            if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
            if (cdHours) cdHours.textContent = String(hours).padStart(2, '0');
            if (cdMins) cdMins.textContent = String(mins).padStart(2, '0');
            if (cdSecs) cdSecs.textContent = String(secs).padStart(2, '0');
          };

          updateCountdown();
          setInterval(updateCountdown, 1000);
        }
      }

      const subscriptionForm = document.querySelector('#alerta-form');
      const subscriptionMessage = document.querySelector('#alerta-mensaje');
      subscriptionForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
        const button = form.querySelector('button[type="submit"]');
        const email = form.querySelector('#alerta-email');
        const consent = form.querySelector('#alerta-consentimiento');
        if (!(email instanceof HTMLInputElement) || !(consent instanceof HTMLInputElement)) return;
        button?.setAttribute('disabled', '');
        if (subscriptionMessage) { subscriptionMessage.textContent = 'Guardando tu suscripción…'; subscriptionMessage.classList.remove('error'); }
        try {
          const response = await fetch('/api/suscripciones', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email.value, consentimiento: consent.checked }) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.mensaje);
          form.reset();
          if (subscriptionMessage) subscriptionMessage.textContent = result.mensaje;
        } catch (error) {
          if (subscriptionMessage) { subscriptionMessage.textContent = error instanceof Error ? error.message : 'No hemos podido guardar tu suscripción.'; subscriptionMessage.classList.add('error'); }
        } finally { button?.removeAttribute('disabled'); }
      });
    </script>
  </body>
</html>


