import Analytics from '@vercel/analytics/astro';
import { createClient } from '@libsql/client';
import { generarSlug } from '../utils/carreras';

const ahora = new Date();
const hoy = ahora.toISOString().split('T')[0];
const fechaLimiteClima = new Date(ahora.getTime() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

const tursoUrl = import.meta.env.TURSO_DATABASE_URL;
const tursoToken = import.meta.env.TURSO_AUTH_TOKEN;

let carreras = [];

if (tursoUrl && tursoToken) {
  try {
    const db = createClient({ url: tursoUrl, authToken: tursoToken });
    const { rows } = await db.execute({
      sql: 'SELECT titulo, fecha, ubicacion, imagen, url_inscripcion, url_ficha, origen, latitud, longitud FROM carreras WHERE fecha >= ? ORDER BY fecha ASC',
      args: [hoy]
    });
    carreras = rows;
  } catch (error) { console.error('Error al conectar con Turso:', error); }
}

const meses = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const mesesLargos = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const fecha = (valor) => { const [a, m, d] = valor.split('-'); const date = new Date(a, m - 1, d); return { dia: date.getDate(), mes: meses[date.getMonth()], completa: `${date.getDate()} ${mesesLargos[date.getMonth()]} ${a}` }; };
const mesesDisponibles = [...new Set(carreras.map((c) => c.fecha.substring(0, 7)))];
const etiquetaMes = (valor) => { const [a, m] = valor.split('-'); return `${mesesLargos[Number(m) - 1]} ${a}`; };
const destacada = carreras[0];

const crearGoogleCalendarUrl = (carrera) => {
  const [a, m, d] = carrera.fecha.split('-').map(Number);
  const inicio = `${a}${String(m).padStart(2, '0')}${String(d).padStart(2, '0')}`;
  const finDate = new Date(Date.UTC(a, m - 1, d + 1));
  const fin = `${finDate.getUTCFullYear()}${String(finDate.getUTCMonth() + 1).padStart(2, '0')}${String(finDate.getUTCDate()).padStart(2, '0')}`;
  const titulo = carrera.titulo;
  const ubicacion = `${carrera.ubicacion || 'Región de Murcia'}, España`;
  const slug = generarSlug(carrera.titulo, carrera.fecha);
  const enlace = `https://calendario-carreras.vercel.app/carrera/${slug}`;
  const detalles = `Información e inscripciones: ${enlace}\n\nEncuentra más carreras en Calendario Murcia Running: https://calendario-carreras.vercel.app`;
  return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(titulo)}&dates=${inicio}/${fin}&details=${encodeURIComponent(detalles)}&location=${encodeURIComponent(ubicacion)}`;
};

const crearWhatsAppShareUrl = (carrera) => {
  const slug = generarSlug(carrera.titulo, carrera.fecha);
  const enlace = `https://calendario-carreras.vercel.app/carrera/${slug}`;
  const texto = `🏃‍♂️ ¡Mira esta carrera en Murcia!\n\n🔥 *${carrera.titulo}*\n📅 ${fecha(carrera.fecha).completa}\n📍 ${carrera.ubicacion || 'Región de Murcia'}\n\n👉 Ficha e inscripciones:\n${enlace}\n\nEncuentra más en: https://calendario-carreras.vercel.app`;
  return `https://api.whatsapp.com/send?text=${encodeURIComponent(texto)}`;
};

const marcadoresMapa = carreras
  .filter((carrera) => Number.isFinite(Number(carrera.latitud)) && Number.isFinite(Number(carrera.longitud)))
  .map((carrera) => ({
    titulo: carrera.titulo,
    ubicacion: carrera.ubicacion,
    fecha: carrera.fecha,
    fechaFormateada: fecha(carrera.fecha).completa,
    mes: carrera.fecha.substring(0, 7),
    search: `${carrera.titulo} ${carrera.ubicacion}`,
    latitud: Number(carrera.latitud),
    longitud: Number(carrera.longitud),
    enlace: `/carrera/${generarSlug(carrera.titulo, carrera.fecha)}`,
    calUrl: crearGoogleCalendarUrl(carrera),
    waUrl: crearWhatsAppShareUrl(carrera)
  }));

// Previsión meteorológica con Open-Meteo para carreras en los próximos 14 días
const interpretarClima = (code) => {
  if (code === 0) return { texto: 'Despejado', icono: '☀️' };
  if (code === 1) return { texto: 'Mayormente despejado', icono: '🌤️' };
  if (code === 2) return { texto: 'Parcialmente nuboso', icono: '⛅' };
  if (code === 3) return { texto: 'Nublado', icono: '☁️' };
  if (code === 45 || code === 48) return { texto: 'Niebla', icono: '🌫️' };
  if ([51, 53, 55, 56, 57].includes(code)) return { texto: 'Llovizna', icono: '🌦️' };
  if ([61, 63, 65, 66, 67, 80, 81, 82].includes(code)) return { texto: 'Lluvia', icono: '🌧️' };
  if ([71, 73, 75, 77, 85, 86].includes(code)) return { texto: 'Nieve', icono: '❄️' };
  if ([95, 96, 99].includes(code)) return { texto: 'Tormenta', icono: '⛈️' };
  return { texto: 'Variable', icono: '🌡️' };
};

const mapaClima = new Map();
const carrerasConClima = carreras.filter((c) =>
  c.fecha >= hoy &&
  c.fecha <= fechaLimiteClima &&
  Number.isFinite(Number(c.latitud)) &&
  Number.isFinite(Number(c.longitud))
);

if (carrerasConClima.length > 0) {
  await Promise.allSettled(
    carrerasConClima.map(async (carrera) => {
      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 2000);
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${carrera.latitud}&longitude=${carrera.longitud}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,wind_speed_10m_max&timezone=Europe/Madrid&start_date=${carrera.fecha}&end_date=${carrera.fecha}`;
        const res = await fetch(url, { signal: controller.signal });
        clearTimeout(timeoutId);
        if (res.ok) {
          const data = await res.json();
          if (data.daily?.time?.length) {
            const code = data.daily.weather_code?.[0] ?? 0;
            const { texto, icono } = interpretarClima(code);
            mapaClima.set(carrera.titulo, {
              texto,
              icono,
              tempMax: Math.round(data.daily.temperature_2m_max?.[0] ?? 0),
              tempMin: Math.round(data.daily.temperature_2m_min?.[0] ?? 0),
              lluvia: data.daily.precipitation_probability_max?.[0] ?? 0,
              viento: Math.round(data.daily.wind_speed_10m_max?.[0] ?? 0),
            });
          }
        }
      } catch {
        // Fallback silencioso para no demorar la carga de página
      }
    })
  );
}

const climaDestacada = destacada ? mapaClima.get(destacada.titulo) : null;
