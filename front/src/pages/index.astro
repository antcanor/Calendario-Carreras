        {destacada && <a class="next-event" href={destacada.url_ficha || destacada.url_inscripcion || '#calendario'} target={destacada.url_ficha || destacada.url_inscripcion ? '_blank' : undefined} rel="noopener noreferrer">
          {destacada.imagen && <img src={destacada.imagen} alt="" />}
          <span class="event-arrow">↗</span><div class="event-content"><span class="event-kicker">Próxima carrera · {fecha(destacada.fecha).completa}</span><h2 class="event-name">{destacada.titulo}</h2><p class="event-place"><i class="bi bi-geo-alt me-1"></i>{destacada.ubicacion}</p>{climaDestacada && <div class="hero-weather"><span class="weather-icon">{climaDestacada.icono}</span><span class="weather-temp">{climaDestacada.tempMax}°C</span><span class="weather-pill">· {climaDestacada.texto}</span><span class="weather-pill">💧 {climaDestacada.lluvia}%</span><span class="weather-pill">💨 {climaDestacada.viento} km/h</span></div>}</div>
        </a>}
      </div>
      <div class="marquee"><span>Actualizado con carreras futuras · {carreras.length} en el radar</span><a class="scroll-cue" href="#calendario">↓ Explorar carreras</a></div>
    </header>
    <main id="calendario">
      <div class="index-head"><div><span class="label" style="color: var(--ink)">01 / Calendario</span><h2>El próximo<br />dorsal.</h2></div><p class="counter">{carreras.length.toString().padStart(2, '0')} carreras<br />por descubrir</p></div>
      <div class="controls"><label class="visually-hidden" for="race-search">Buscar carrera</label><input class="search" id="race-search" type="search" placeholder="Buscar por carrera o ubicación…" autocomplete="off" /><div class="filters" aria-label="Filtrar calendario por mes"><button class="filter active" data-filter="all">Todo el calendario</button>{mesesDisponibles.map((mes) => <button class="filter" data-filter={mes}>{etiquetaMes(mes)}</button>)}</div></div>
      <section class="race-list" aria-label="Listado de carreras">
        {carreras.map((carrera, indice) => { const cuando = fecha(carrera.fecha); const mesFiltro = carrera.fecha.substring(0, 7); const clima = mapaClima.get(carrera.titulo); return <article class="race" data-mes={mesFiltro} data-search={`${carrera.titulo} ${carrera.ubicacion}`}><div class="date">{cuando.dia}<span>{cuando.mes}</span></div><div class="race-image">{carrera.imagen ? <img src={carrera.imagen} alt="" loading="lazy" /> : <i class="bi bi-flag-fill"></i>}</div><div><p class="race-title">{carrera.titulo}</p><p class="race-place"><i class="bi bi-geo-alt me-1"></i>{carrera.ubicacion}</p>{clima && <div class="race-weather" title={`Previsión día de carrera: ${clima.texto}, viento ${clima.viento} km/h`}><span class="weather-icon">{clima.icono}</span><span class="weather-temp">{clima.tempMax}°C</span><span class="weather-rain">💧 {clima.lluvia}%</span><span class="weather-wind">💨 {clima.viento} km/h</span></div>}</div><div class="race-meta">#{String(indice + 1).padStart(2, '0')}<br />{carrera.origen || 'Agenda Murcia'}</div><div class="race-links"><a class="action cal-action" href={crearGoogleCalendarUrl(carrera)} target="_blank" rel="noopener noreferrer" aria-label={`Añadir ${carrera.titulo} a Google Calendar`} title="Añadir a Google Calendar"><i class="bi bi-calendar-plus"></i> Cal</a>{carrera.url_ficha && <a class="action" href={carrera.url_ficha} target="_blank" rel="noopener noreferrer" aria-label={`Ver detalles de ${carrera.titulo}`}>Info</a>}{carrera.url_inscripcion && <a class="action primary" href={carrera.url_inscripcion} target="_blank" rel="noopener noreferrer" aria-label={`Inscribirse a ${carrera.titulo}`}>Ir ↗</a>}</div></article>; })}
      </section>
      <div class="empty" id="no-results" hidden>No hay carreras con esos criterios. Prueba con otro nombre, ubicación o mes.</div>
      {carreras.length === 0 && <div class="empty">Aún no hay próximas pruebas publicadas. Vuelve pronto.</div>}
      <section class="map-section" id="mapa" aria-labelledby="mapa-title"><div class="map-head"><div><span class="label" style="color: var(--ink)">02 / Mapa</span><h3 id="mapa-title">Corre por<br />el mapa.</h3></div><p>{marcadoresMapa.length ? `${marcadoresMapa.length} carreras ya localizadas. Toca un punto para ver los detalles.` : 'Estamos localizando las próximas carreras para situarlas aquí.'}</p></div>{marcadoresMapa.length ? <div id="race-map" aria-label="Mapa de carreras"></div> : <div class="map-empty"><div><strong>Mapa en preparación</strong>Ejecuta el geocodificador para mostrar las carreras por ubicación.</div></div>}</section>
      <section class="alerta" id="alertas" aria-labelledby="alerta-title">
        <div class="alerta-content"><span class="label">03 / Alerta mensual</span><h3 id="alerta-title">Tu próximo<br />dorsal, en tu inbox.</h3><p>Una vez al mes: las nuevas carreras de Murcia, fechas que no deberías dejar escapar y nada de ruido.</p></div>
        <form class="alerta-form" id="alerta-form"><label for="alerta-email">Tu email</label><div class="alerta-fields"><input id="alerta-email" name="email" type="email" placeholder="corredor@ejemplo.com" autocomplete="email" required /><button type="submit">Quiero recibirla ↗</button></div><div class="consent"><input id="alerta-consentimiento" name="consentimiento" type="checkbox" required /><label for="alerta-consentimiento">Acepto recibir la alerta mensual de carreras por email.</label></div><p class="form-message" id="alerta-mensaje" role="status" aria-live="polite"></p><small>Una alerta al mes. Puedes darte de baja cuando quieras.</small></form>
      </section>
    </main>
    <footer class="footer"><span>CALENDARIO/MURCIA/RUNNING © {new Date().getFullYear()}</span><span>Tu próximo kilómetro empieza aquí.</span></footer>
    <Analytics />
    {marcadoresMapa.length > 0 && <><script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script><script define:vars={{ marcadoresMapa }}>
      const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[character]);
      const map = L.map('race-map', { scrollWheelZoom: false });
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);
      const bounds = [];
      marcadoresMapa.forEach((carrera) => { const point = [carrera.latitud, carrera.longitud]; bounds.push(point); const link = carrera.enlace ? `<a class="map-popup-link" target="_blank" rel="noopener noreferrer" href="${escapeHtml(carrera.enlace)}">Ver carrera ↗</a>` : ''; const calBtn = carrera.calUrl ? `<a class="map-popup-link" target="_blank" rel="noopener noreferrer" href="${escapeHtml(carrera.calUrl)}" style="margin-left:0.75rem;"><i class="bi bi-calendar-plus"></i> + Cal</a>` : ''; L.circleMarker(point, { radius: 8, color: '#121315', weight: 2, fillColor: '#ff5a1f', fillOpacity: 1 }).addTo(map).bindPopup(`<strong class="map-popup-title">${escapeHtml(carrera.titulo)}</strong><span class="map-popup-meta">${escapeHtml(carrera.fecha)} · ${escapeHtml(carrera.ubicacion)}</span>${link}${calBtn}`); });
      if (bounds.length === 1) map.setView(bounds[0], 12); else map.fitBounds(bounds, { padding: [36, 36], maxZoom: 11 });
    </script></>}
    <script>
      const buttons = document.querySelectorAll('.filter');
      const races = document.querySelectorAll('.race');
      const search = document.querySelector('#race-search');
      const empty = document.querySelector('#no-results');
      let selectedMonth = 'all';

      const normalize = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const updateList = () => {
        const query = normalize(search?.value.trim() || '');
        let total = 0;
        races.forEach((race) => {
          const matchesMonth = selectedMonth === 'all' || race.dataset.mes === selectedMonth;
          const matchesSearch = !query || normalize(race.dataset.search || '').includes(query);
          const show = matchesMonth && matchesSearch;
          race.hidden = !show;
          if (show) total++;
        });
        if (empty) empty.hidden = total !== 0;
      };

      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        selectedMonth = button.dataset.filter || 'all';
        updateList();
      }));
      search?.addEventListener('input', updateList);
      const subscriptionForm = document.querySelector('#alerta-form');
      const subscriptionMessage = document.querySelector('#alerta-mensaje');
      subscriptionForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
        const button = form.querySelector('button[type="submit"]');
        const email = form.querySelector('#alerta-email');
        const consent = form.querySelector('#alerta-consentimiento');
        if (!(email instanceof HTMLInputElement) || !(consent instanceof HTMLInputElement)) return;
        button?.setAttribute('disabled', '');
        if (subscriptionMessage) { subscriptionMessage.textContent = 'Guardando tu suscripción…'; subscriptionMessage.classList.remove('error'); }
        try {
          const response = await fetch('/api/suscripciones', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email.value, consentimiento: consent.checked }) });
          const result = await response.json();
          if (!response.ok) throw new Error(result.mensaje);
          form.reset();
          if (subscriptionMessage) subscriptionMessage.textContent = result.mensaje;
        } catch (error) {
          if (subscriptionMessage) { subscriptionMessage.textContent = error instanceof Error ? error.message : 'No hemos podido guardar tu suscripción.'; subscriptionMessage.classList.add('error'); }
        } finally { button?.removeAttribute('disabled'); }
      });
    </script>
  </body>
</html>


