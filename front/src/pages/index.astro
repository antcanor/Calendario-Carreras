ll { display:block; margin-top:.85rem; color:#898984; font-size:.72rem; line-height:1.4; } .form-message { min-height:1.4rem; margin:.8rem 0 0; color:var(--acid); font-size:.8rem; } .form-message.error { color:#ff9a7c; }
