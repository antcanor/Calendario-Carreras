---
import Analytics from '@vercel/analytics/astro';
import { createClient } from '@libsql/client';

const hoy = new Date().toISOString().split('T')[0];
const tursoUrl = import.meta.env.TURSO_DATABASE_URL;
const tursoToken = import.meta.env.TURSO_AUTH_TOKEN;

let carreras = [];

if (tursoUrl && tursoToken) {
  try {
    const db = createClient({ url: tursoUrl, authToken: tursoToken });
    const { rows } = await db.execute({
      sql: 'SELECT titulo, fecha, ubicacion, imagen, url_inscripcion, url_ficha, origen FROM carreras WHERE fecha >= ? ORDER BY fecha ASC',
      args: [hoy]
    });
    carreras = rows;
  } catch (error) { console.error('Error al conectar con Turso:', error); }
}

const meses = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const mesesLargos = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
const fecha = (valor) => { const [a, m, d] = valor.split('-'); const date = new Date(a, m - 1, d); return { dia: date.getDate(), mes: meses[date.getMonth()], completa: `${date.getDate()} ${mesesLargos[date.getMonth()]} ${a}` }; };
const mesesDisponibles = [...new Set(carreras.map((c) => c.fecha.substring(0, 7)))];
const etiquetaMes = (valor) => { const [a, m] = valor.split('-'); return `${mesesLargos[Number(m) - 1]} ${a}`; };
const destacada = carreras[0];
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="El índice independiente de carreras populares y trail de la Región de Murcia." />
    <title>CALENDARIO / MURCIA / RUNNING — Calendario de carreras</title>
    <link rel="icon" type="image/png" href="/assets/logo-removedbg.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=DM+Mono:wght@400;500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      :root { --ink:#121315; --acid:#ff5a1f; --paper:#f4f1ea; --mist:#d8d7d1; --line:rgba(18,19,21,.22); }
      .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
      * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; background:var(--paper); color:var(--ink); font-family:'DM Sans',sans-serif; } a { color:inherit; } .mono { font-family:'DM Mono',monospace; }
      .masthead { min-height:100svh; padding:1.35rem clamp(1.1rem,4vw,4rem) 1.8rem; display:grid; grid-template-rows:auto 1fr auto; background:var(--ink); color:var(--paper); overflow:hidden; position:relative; } .masthead::after { content:'MURCIA'; position:absolute; right:-.07em; bottom:-.24em; font:clamp(12rem,31vw,31rem)/.72 'Archivo Black',sans-serif; letter-spacing:-.12em; color:rgba(255,255,255,.035); pointer-events:none; }
      .navline, .marquee, .event-kicker, .counter, .filter, .date-tag { font:500 .69rem/1.2 'DM Mono',monospace; letter-spacing:.07em; text-transform:uppercase; } .navline { display:flex; align-items:center; justify-content:space-between; gap:1rem; position:relative; z-index:1; } .brand { font:1rem/1 'Archivo Black',sans-serif; text-decoration:none; letter-spacing:-.07em; } .brand span { color:var(--acid); } .navlink { text-decoration:none; border-bottom:1px solid var(--acid); padding-bottom:.2rem; }
      .hero { max-width:1300px; width:100%; margin:auto; align-self:center; display:grid; grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr); align-items:end; gap:3rem; position:relative; z-index:1; } .hero-copy { padding-top:5rem; } .label { color:var(--acid); font:500 .72rem 'DM Mono',monospace; letter-spacing:.08em; text-transform:uppercase; } h1 { max-width:850px; margin:.55rem 0 0; font:clamp(4rem,10vw,10.5rem)/.78 'Archivo Black',sans-serif; letter-spacing:-.09em; text-transform:uppercase; } h1 i { color:var(--acid); font-style:normal; } .hero-description { max-width:31rem; margin:1.7rem 0 0; font-size:clamp(1rem,1.4vw,1.25rem); line-height:1.45; color:#c3c3bd; }
      .next-event { display:block; min-height:25rem; text-decoration:none; position:relative; background:#292a2b; overflow:hidden; } .next-event img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:.72; filter:grayscale(1) contrast(1.1); transition:transform .5s ease,filter .5s ease; } .next-event:hover img { transform:scale(1.05); filter:grayscale(0) contrast(1); } .next-event::after { content:''; position:absolute; inset:0; background:linear-gradient(0deg,rgba(0,0,0,.88),transparent 68%); } .event-content { position:absolute; inset:auto 1.2rem 1.2rem; z-index:1; } .event-kicker { color:var(--acid); } .event-name { margin:.5rem 0; font-size:1.45rem; font-weight:700; line-height:1.08; } .event-place { margin:0; color:#deded8; font-size:.87rem; } .event-arrow { position:absolute; z-index:2; top:1rem; right:1rem; display:grid; place-items:center; width:2.5rem; height:2.5rem; background:var(--acid); color:var(--ink); font-size:1.3rem; border-radius:50%; }
      .marquee { display:flex; justify-content:space-between; align-items:end; position:relative; z-index:1; padding-top:2rem; color:#afafa9; border-top:1px solid rgba(255,255,255,.2); } .scroll-cue { color:var(--acid); text-decoration:none; }
      main { padding:clamp(4rem,9vw,8rem) clamp(1.1rem,4vw,4rem); max-width:1600px; margin:auto; } .index-head { display:grid; grid-template-columns:1fr auto; gap:2rem; padding-bottom:2rem; border-bottom:2px solid var(--ink); align-items:end; } h2 { max-width:950px; margin:.5rem 0 0; font:clamp(3.2rem,8vw,8rem)/.8 'Archivo Black',sans-serif; letter-spacing:-.09em; text-transform:uppercase; } .counter { text-align:right; padding-bottom:.45rem; }
      .controls { padding:1.35rem 0 1.8rem; border-bottom:1px solid var(--line); } .search { width:100%; margin-bottom:.8rem; padding:.82rem 0; border:0; border-bottom:2px solid var(--ink); border-radius:0; outline:0; color:var(--ink); background:transparent; font:500 1rem 'DM Mono',monospace; } .search::placeholder { color:#747570; } .search:focus { border-color:var(--acid); } .filters { display:flex; flex-wrap:wrap; gap:.45rem; } .filter { appearance:none; padding:.62rem .8rem; background:transparent; border:1px solid var(--line); border-radius:0; color:var(--ink); cursor:pointer; transition:.18s; } .filter:hover, .filter.active { background:var(--ink); border-color:var(--ink); color:var(--acid); }
      .race-list { display:grid; } .race { display:grid; grid-template-columns:5.2rem 5.5rem minmax(0,1fr) minmax(9rem,.55fr) auto; align-items:center; gap:1.4rem; padding:1.15rem 0; border-bottom:1px solid var(--line); transition:padding .22s,background .22s; } .race[hidden] { display:none; } .race:hover { padding-left:1rem; padding-right:1rem; background:var(--acid); } .race-image { width:5.5rem; height:5.5rem; overflow:hidden; background:#292a2b; } .race-image img { width:100%; height:100%; object-fit:cover; filter:grayscale(1); transition:filter .2s,transform .25s; } .race:hover .race-image img { filter:grayscale(0); transform:scale(1.06); } .race-image i { display:grid; height:100%; place-items:center; color:var(--acid); font-size:1.25rem; } .date { font:clamp(2.6rem,4vw,4.8rem)/.8 'Archivo Black',sans-serif; letter-spacing:-.08em; } .date span { display:block; margin-top:.45rem; font:500 .65rem 'DM Mono',monospace; letter-spacing:.08em; } .race-title { margin:0; font-size:clamp(1.2rem,2.2vw,2rem); line-height:1.05; letter-spacing:-.045em; font-weight:700; } .race-place { margin:.35rem 0 0; color:#5b5d5a; font-size:.87rem; } .race-meta { font:500 .68rem/1.55 'DM Mono',monospace; color:#5b5d5a; text-transform:uppercase; } .race-links { display:flex; align-items:center; justify-content:flex-end; gap:.5rem; } .action { display:inline-flex; align-items:center; justify-content:center; min-width:2.55rem; height:2.55rem; padding:0 .85rem; border:1px solid var(--ink); font:500 .68rem 'DM Mono',monospace; text-decoration:none; text-transform:uppercase; letter-spacing:.04em; transition:.18s; } .action:hover { color:var(--paper); background:var(--ink); } .action.primary { color:var(--ink); background:var(--acid); border-color:var(--acid); } .action.primary:hover { background:var(--ink); color:var(--acid); }
      .empty { padding:4rem 1rem; text-align:center; border-bottom:1px solid var(--line); font-size:1.1rem; } .footer { padding:1.5rem clamp(1.1rem,4vw,4rem); display:flex; justify-content:space-between; background:var(--acid); font:500 .68rem 'DM Mono',monospace; text-transform:uppercase; letter-spacing:.06em; }
      @media (max-width:760px) { .masthead { min-height:auto; } .hero { grid-template-columns:1fr; gap:2rem; } .hero-copy { padding-top:4.5rem; } h1 { font-size:clamp(4rem,18vw,7rem); } .next-event { min-height:18rem; } .index-head { grid-template-columns:1fr; gap:.5rem; } .counter { text-align:left; } .race { grid-template-columns:4.2rem 3.5rem minmax(0,1fr) auto; gap:.75rem; } .race-image { width:3.5rem; height:3.5rem; } .race-meta { display:none; } .date { font-size:2.6rem; } .race-links { flex-direction:column; } .action { min-width:2.4rem; padding:0 .55rem; } .footer { gap:1rem; flex-direction:column; } }
    </style>
  </head>
  <body>
    <header class="masthead">
      <nav class="navline"><a class="brand" href="#top">CALENDARIO<span>/</span>MURCIA<span>/</span>RUNNING</a><a class="navlink" href="#calendario">Ver calendario ↓</a></nav>
      <div class="hero" id="top">
        <div class="hero-copy"><span class="label">Calendario de carreras · Región de Murcia</span><h1>Busca.<br />Corre.<br /><i>Vuelve.</i></h1><p class="hero-description">Un punto de partida para quienes llenan los domingos de kilómetros. Carreras populares, trail y retos de la Región de Murcia.</p></div>
        {destacada && <a class="next-event" href={destacada.url_ficha || destacada.url_inscripcion || '#calendario'} target={destacada.url_ficha || destacada.url_inscripcion ? '_blank' : undefined} rel="noopener noreferrer">
          {destacada.imagen && <img src={destacada.imagen} alt="" />}
          <span class="event-arrow">↗</span><div class="event-content"><span class="event-kicker">Próxima carrera · {fecha(destacada.fecha).completa}</span><h2 class="event-name">{destacada.titulo}</h2><p class="event-place"><i class="bi bi-geo-alt me-1"></i>{destacada.ubicacion}</p></div>
        </a>}
      </div>
      <div class="marquee"><span>Actualizado con carreras futuras · {carreras.length} en el radar</span><a class="scroll-cue" href="#calendario">↓ Explorar carreras</a></div>
    </header>
    <main id="calendario">
      <div class="index-head"><div><span class="label" style="color: var(--ink)">01 / Calendario</span><h2>El próximo<br />dorsal.</h2></div><p class="counter">{carreras.length.toString().padStart(2, '0')} carreras<br />por descubrir</p></div>
      <div class="controls"><label class="visually-hidden" for="race-search">Buscar carrera</label><input class="search" id="race-search" type="search" placeholder="Buscar por carrera o ubicación…" autocomplete="off" /><div class="filters" aria-label="Filtrar calendario por mes"><button class="filter active" data-filter="all">Todo el calendario</button>{mesesDisponibles.map((mes) => <button class="filter" data-filter={mes}>{etiquetaMes(mes)}</button>)}</div></div>
      <section class="race-list" aria-label="Listado de carreras">
        {carreras.map((carrera, indice) => { const cuando = fecha(carrera.fecha); const mesFiltro = carrera.fecha.substring(0, 7); return <article class="race" data-mes={mesFiltro} data-search={`${carrera.titulo} ${carrera.ubicacion}`}><div class="date">{cuando.dia}<span>{cuando.mes}</span></div><div class="race-image">{carrera.imagen ? <img src={carrera.imagen} alt="" loading="lazy" /> : <i class="bi bi-flag-fill"></i>}</div><div><p class="race-title">{carrera.titulo}</p><p class="race-place"><i class="bi bi-geo-alt me-1"></i>{carrera.ubicacion}</p></div><div class="race-meta">#{String(indice + 1).padStart(2, '0')}<br />{carrera.origen || 'Agenda Murcia'}</div><div class="race-links">{carrera.url_ficha && <a class="action" href={carrera.url_ficha} target="_blank" rel="noopener noreferrer" aria-label={`Ver detalles de ${carrera.titulo}`}>Info</a>}{carrera.url_inscripcion && <a class="action primary" href={carrera.url_inscripcion} target="_blank" rel="noopener noreferrer" aria-label={`Inscribirse a ${carrera.titulo}`}>Ir ↗</a>}</div></article>; })}
      </section>
      <div class="empty" id="no-results" hidden>No hay carreras con esos criterios. Prueba con otro nombre, ubicación o mes.</div>
      {carreras.length === 0 && <div class="empty">Aún no hay próximas pruebas publicadas. Vuelve pronto.</div>}
    </main>
    <footer class="footer"><span>CALENDARIO/MURCIA/RUNNING © {new Date().getFullYear()}</span><span>Tu próximo kilómetro empieza aquí.</span></footer>
    <Analytics />
    <script>
      const buttons = document.querySelectorAll('.filter');
      const races = document.querySelectorAll('.race');
      const search = document.querySelector('#race-search');
      const empty = document.querySelector('#no-results');
      let selectedMonth = 'all';

      const normalize = (value) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      const updateList = () => {
        const query = normalize(search?.value.trim() || '');
        let total = 0;
        races.forEach((race) => {
          const matchesMonth = selectedMonth === 'all' || race.dataset.mes === selectedMonth;
          const matchesSearch = !query || normalize(race.dataset.search || '').includes(query);
          const show = matchesMonth && matchesSearch;
          race.hidden = !show;
          if (show) total++;
        });
        if (empty) empty.hidden = total !== 0;
      };

      buttons.forEach((button) => button.addEventListener('click', () => {
        buttons.forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        selectedMonth = button.dataset.filter || 'all';
        updateList();
      }));
      search?.addEventListener('input', updateList);
    </script>
  </body>
</html>


