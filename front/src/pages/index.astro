---
import Base from '../layouts/Base.astro';
import { createClient } from '@libsql/client';
import { formatearFecha, etiquetaMes, generarSlug, crearGoogleCalendarUrl, crearWhatsAppShareUrl, leerDistancias, formatearDistancias, formatearPrecio } from '../utils/carreras';
import { obtenerClima } from '../utils/clima';

const hoy = new Date().toISOString().split('T')[0];

const tursoUrl = import.meta.env.TURSO_DATABASE_URL;
const tursoToken = import.meta.env.TURSO_AUTH_TOKEN;

let filas = [];

if (tursoUrl && tursoToken) {
  try {
    const db = createClient({ url: tursoUrl, authToken: tursoToken });
    const { rows } = await db.execute({
      sql: 'SELECT titulo, fecha, ubicacion, imagen, url_inscripcion, url_ficha, origen, latitud, longitud, modalidad, distancias, precio_min, precio_max FROM carreras WHERE fecha >= ? ORDER BY fecha ASC',
      args: [hoy]
    });
    filas = rows;
  } catch (error) { console.error('Error al conectar con Turso:', error); }
}

const tieneCoordenadas = (c) => c.latitud != null && c.longitud != null && Number.isFinite(Number(c.latitud)) && Number.isFinite(Number(c.longitud));

// Previsión solo para las carreras de los próximos 14 días (obtenerClima descarta el resto sin llamar a la API)
const carreras = await Promise.all(filas.map(async (c) => {
  const slug = generarSlug(c.titulo, c.fecha);
  return {
    ...c,
    slug,
    cuando: formatearFecha(c.fecha),
    enlace: `/carrera/${slug}`,
    calUrl: crearGoogleCalendarUrl(c, slug),
    waUrl: crearWhatsAppShareUrl(c, slug),
    clima: await obtenerClima(c.latitud, c.longitud, c.fecha),
    kms: leerDistancias(c.distancias).join(','),
    distanciasTexto: formatearDistancias(c.distancias, 4),
    precioTexto: formatearPrecio(c.precio_min, c.precio_max),
  };
}));

// Solo se ofrecen como filtro las modalidades que tienen alguna carrera
const modalidades = [...new Set(carreras.map((c) => c.modalidad).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));

const destacada = carreras[0];

const grupos = [];
for (const carrera of carreras) {
  const mes = carrera.fecha.substring(0, 7);
  const ultimo = grupos[grupos.length - 1];
  if (ultimo?.mes === mes) ultimo.carreras.push(carrera);
  else grupos.push({ mes, etiqueta: etiquetaMes(mes), carreras: [carrera] });
}

const marcadoresMapa = carreras.filter(tieneCoordenadas).map((c) => ({
  slug: c.slug,
  titulo: c.titulo,
  ubicacion: c.ubicacion,
  fechaFormateada: c.cuando.completa,
  latitud: Number(c.latitud),
  longitud: Number(c.longitud),
  enlace: c.enlace,
  calUrl: c.calUrl,
  waUrl: c.waUrl,
}));

const schemaIndex = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Calendario de Carreras de la Región de Murcia",
  "description": "El índice independiente de carreras populares, trail y maratón de la Región de Murcia.",
  "url": "https://carreras-murcia.vercel.app/",
  "itemListElement": carreras.slice(0, 30).map((c, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "SportsEvent",
      "name": c.titulo,
      "startDate": `${c.fecha}T09:00:00+02:00`,
      "url": `https://carreras-murcia.vercel.app/carrera/${c.slug}`,
      "location": {
        "@type": "Place",
        "name": c.ubicacion || "Región de Murcia",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": c.ubicacion || "Murcia",
          "addressRegion": "Región de Murcia",
          "addressCountry": "ES"
        }
      }
    }
  }))
};
---

<Base
  titulo="CALENDARIO / MURCIA / RUNNING — Calendario de carreras"
  descripcion="El índice independiente de carreras populares, trail y maratón de la Región de Murcia. Fechas, ubicaciones, clima e inscripciones."
  canonical="https://carreras-murcia.vercel.app/"
  schema={schemaIndex}
  verificacionGoogle="ysx-hA1nKYE_4TflEcrQQJY9YBlH_fC-Eqqo4nIqVFI"
>
  <section class="portada">
    <div class="contenedor portada-rejilla">
      <div class="portada-texto">
        <h1>Las carreras de Murcia, por orden de salida</h1>
        <p>
          {carreras.length > 0
            ? `${carreras.length} carreras populares, trails y maratones de la Región de Murcia. Cada una con su fecha, su lugar, la previsión del tiempo y el enlace para inscribirte.`
            : 'Carreras populares, trails y maratones de la Región de Murcia. Cada una con su fecha, su lugar, la previsión del tiempo y el enlace para inscribirte.'}
        </p>
        <a class="boton boton-marino" href="#calendario">Ver el calendario <i class="bi bi-arrow-down" aria-hidden="true"></i></a>
      </div>

      {destacada && (
        <a class="dorsal" href={destacada.enlace} aria-label={`Próxima carrera: ${destacada.titulo}, ${destacada.cuando.larga}. Ver ficha`}>
          <span class="dorsal-ojal o1"></span><span class="dorsal-ojal o2"></span><span class="dorsal-ojal o3"></span><span class="dorsal-ojal o4"></span>
          <div class="dorsal-banda">
            <span>Próxima salida</span>
            <span>{destacada.cuando.larga}</span>
          </div>
          <div class="dorsal-cuerpo">
            <div class="dorsal-numero">
              <strong>{destacada.cuando.dia.padStart(2, '0')}</strong>
              <span>{destacada.cuando.mes}</span>
            </div>
            <h2>{destacada.titulo}</h2>
            <p class="dorsal-lugar"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> {destacada.ubicacion}</p>
            {destacada.clima && (
              <p class="clima">
                <span class="clima-temp"><i class={`bi ${destacada.clima.icono}`} aria-hidden="true"></i> {destacada.clima.tempMax} °C, {destacada.clima.texto.toLowerCase()}</span>
                <span><i class="bi bi-droplet" aria-hidden="true"></i> {destacada.clima.lluvia} %</span>
                <span><i class="bi bi-wind" aria-hidden="true"></i> {destacada.clima.viento} km/h</span>
              </p>
            )}
          </div>
          <div class="dorsal-pie cuenta" data-cuenta={destacada.fecha}>
            <span>Faltan</span>
            <span class="cuenta-tramo"><strong data-cd="d">--</strong> d</span>
            <span class="cuenta-tramo"><strong data-cd="h">--</strong> h</span>
            <span class="cuenta-tramo"><strong data-cd="m">--</strong> min</span>
            <span class="cuenta-tramo"><strong data-cd="s">--</strong> s</span>
          </div>
        </a>
      )}
    </div>
  </section>

  <main>
    <section class="seccion contenedor" id="calendario" aria-labelledby="calendario-titulo">
      <div class="seccion-cabecera">
        <h2 id="calendario-titulo">Calendario</h2>
        <p id="resultado" role="status" aria-live="polite">{carreras.length} {carreras.length === 1 ? 'carrera' : 'carreras'}</p>
      </div>

      {carreras.length > 0 && (
        <div class="controles">
          <div class="buscador">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="solo-lectores" for="buscar">Buscar carrera</label>
            <input id="buscar" type="search" placeholder="Busca por nombre o localidad" autocomplete="off" />
          </div>
          <div class="selectores">
            <label class="selector">
              <span>Modalidad</span>
              <select id="filtro-modalidad">
                <option value="">Todas</option>
                {modalidades.map((m) => <option value={m}>{m}</option>)}
              </select>
            </label>
            <label class="selector">
              <span>Distancia</span>
              <select id="filtro-distancia">
                <option value="">Cualquiera</option>
                <option value="0-5">Hasta 5 km</option>
                <option value="5-10">De 5 a 10 km</option>
                <option value="10-21.1">De 10 km a media maratón</option>
                <option value="21.1-999">Más de media maratón</option>
              </select>
            </label>
          </div>
          <div class="filtros" role="group" aria-label="Filtrar por fecha">
            <button class="filtro" type="button" data-filtro="all" aria-pressed="true">Todas</button>
            <button class="filtro" type="button" data-filtro="weekend" aria-pressed="false">Este fin de semana</button>
            <button class="filtro" type="button" data-filtro="15days" aria-pressed="false">Próximos 15 días</button>
            <button class="filtro" type="button" data-filtro="30days" aria-pressed="false">Próximos 30 días</button>
            <span class="filtros-corte" aria-hidden="true"></span>
            {grupos.map((g) => <button class="filtro" type="button" data-filtro={g.mes} aria-pressed="false">{g.etiqueta}</button>)}
          </div>
        </div>
      )}

      {grupos.map((grupo) => (
        <section class="mes" data-mes={grupo.mes}>
          <h3 class="mes-titulo">{grupo.etiqueta}</h3>
          <ul class="lista">
            {grupo.carreras.map((carrera) => (
              <li class="carrera" data-fecha={carrera.fecha} data-slug={carrera.slug} data-buscar={`${carrera.titulo} ${carrera.ubicacion}`} data-modalidad={carrera.modalidad || ''} data-kms={carrera.kms}>
                <div class="carrera-fecha" aria-hidden="true">
                  <strong>{carrera.cuando.dia}</strong>
                  <span>{carrera.cuando.diaSemana}</span>
                </div>
                <div class="carrera-cartel">
                  {carrera.imagen ? <img src={carrera.imagen} alt="" loading="lazy" /> : <i class="bi bi-flag-fill" aria-hidden="true"></i>}
                </div>
                <div class="carrera-datos">
                  <a class="carrera-titulo" href={carrera.enlace}>
                    <span class="solo-lectores">{carrera.cuando.larga}: </span>{carrera.titulo}
                  </a>
                  <div class="carrera-detalle">
                    {tieneCoordenadas(carrera)
                      ? <button class="carrera-lugar" type="button" data-localizar={carrera.slug} title="Ver en el mapa"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> {carrera.ubicacion}</button>
                      : <span class="carrera-lugar"><i class="bi bi-geo-alt-fill" aria-hidden="true"></i> {carrera.ubicacion}</span>}
                    {carrera.modalidad && carrera.modalidad !== 'Running' && <span class="carrera-modalidad">{carrera.modalidad}</span>}
                    {carrera.distanciasTexto && <span class="carrera-dato" title="Distancias"><i class="bi bi-signpost-split" aria-hidden="true"></i> {carrera.distanciasTexto}</span>}
                    {carrera.precioTexto && <span class="carrera-dato" title="Precio de inscripción"><i class="bi bi-tag" aria-hidden="true"></i> {carrera.precioTexto}</span>}
                    {carrera.clima && (
                      <span class="clima" title={`Previsión para el día de la carrera: ${carrera.clima.texto.toLowerCase()}`}>
                        <span class="clima-temp"><i class={`bi ${carrera.clima.icono}`} aria-hidden="true"></i> {carrera.clima.tempMax} °C</span>
                        <span><i class="bi bi-droplet" aria-hidden="true"></i> {carrera.clima.lluvia} %</span>
                        <span><i class="bi bi-wind" aria-hidden="true"></i> {carrera.clima.viento} km/h</span>
                      </span>
                    )}
                  </div>
                </div>
                <div class="carrera-acciones">
                  <a class="boton boton-icono" href={carrera.waUrl} target="_blank" rel="noopener noreferrer" aria-label={`Compartir ${carrera.titulo} por WhatsApp`} title="Compartir por WhatsApp"><i class="bi bi-whatsapp" aria-hidden="true"></i></a>
                  <a class="boton boton-icono" href={carrera.calUrl} target="_blank" rel="noopener noreferrer" aria-label={`Añadir ${carrera.titulo} a Google Calendar`} title="Añadir a Google Calendar"><i class="bi bi-calendar-plus" aria-hidden="true"></i></a>
                  <a class="boton carrera-ficha" href={carrera.enlace} aria-label={`Ver ficha de ${carrera.titulo}`}>Ver ficha</a>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <p class="vacio" id="sin-resultados" hidden>Ninguna carrera coincide. Prueba con otro nombre, otra localidad u otras fechas.</p>
      {carreras.length === 0 && <p class="vacio">Todavía no hay carreras publicadas. El calendario se actualiza cada día.</p>}
    </section>

    <section class="seccion contenedor" id="mapa" aria-labelledby="mapa-titulo">
      <div class="seccion-cabecera">
        <h2 id="mapa-titulo">Mapa</h2>
        <p>{marcadoresMapa.length > 0 ? 'Toca un punto para ver la carrera. El mapa sigue los filtros del calendario.' : 'Todavía no hay carreras localizadas en el mapa.'}</p>
      </div>
      {marcadoresMapa.length > 0 && <div id="mapa-carreras" class="mapa" aria-label="Mapa de carreras"></div>}
    </section>

    <section class="seccion contenedor" id="ritmos" aria-labelledby="ritmos-titulo">
      <div class="seccion-cabecera">
        <h2 id="ritmos-titulo">Calcula tu ritmo</h2>
        <p>Elige distancia y marca objetivo para saber a cuánto tienes que ir.</p>
      </div>
      <div class="ritmos">
        <div class="ritmos-entrada">
          <fieldset>
            <legend>Distancia</legend>
            <div class="distancias">
              <button type="button" class="filtro" data-dist="5" aria-pressed="false">5 km</button>
              <button type="button" class="filtro" data-dist="10" aria-pressed="true">10 km</button>
              <button type="button" class="filtro" data-dist="21.0975" aria-pressed="false">Media maratón</button>
              <button type="button" class="filtro" data-dist="42.195" aria-pressed="false">Maratón</button>
              <button type="button" class="filtro" data-dist="custom" aria-pressed="false">Otra</button>
            </div>
            <div class="campo" id="otra-distancia" hidden>
              <label for="km-libres">Kilómetros</label>
              <input type="number" id="km-libres" min="0.1" max="250" step="0.1" value="7.5" inputmode="decimal" />
            </div>
          </fieldset>
          <fieldset>
            <legend>Tiempo objetivo</legend>
            <div class="tiempo">
              <div class="campo"><input type="number" id="t-horas" min="0" max="99" value="0" inputmode="numeric" /><label for="t-horas">horas</label></div>
              <div class="campo"><input type="number" id="t-min" min="0" max="59" value="45" inputmode="numeric" /><label for="t-min">minutos</label></div>
              <div class="campo"><input type="number" id="t-seg" min="0" max="59" value="0" inputmode="numeric" /><label for="t-seg">segundos</label></div>
            </div>
          </fieldset>
        </div>
        <div class="ritmos-salida" aria-live="polite">
          <div class="ritmo-cifras">
            <p class="ritmo-principal"><strong id="ritmo-km">4:30</strong> min/km</p>
            <p class="ritmo-velocidad"><strong id="ritmo-vel">13,33</strong> km/h</p>
          </div>
          <table class="pasos">
            <caption>Tiempos de paso</caption>
            <tbody id="pasos-cuerpo"></tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    {marcadoresMapa.length > 0 && (
      <>
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script define:vars={{ marcadoresMapa }}>
          const escapar = (valor) => String(valor ?? '').replace(/[&<>'"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' })[c]);
          const map = L.map('mapa-carreras', { scrollWheelZoom: false });
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors' }).addTo(map);

          const puntos = marcadoresMapa.map((carrera) => {
            const punto = [carrera.latitud, carrera.longitud];
            const marker = L.circleMarker(punto, { radius: 8, color: '#12264a', weight: 2, fillColor: '#ffc91f', fillOpacity: 1 })
              .addTo(map)
              .bindPopup(`<strong class="popup-titulo">${escapar(carrera.titulo)}</strong><span class="popup-meta">${escapar(carrera.fechaFormateada)}, ${escapar(carrera.ubicacion)}</span><span class="popup-enlaces"><a href="${escapar(carrera.enlace)}">Ver ficha</a><a target="_blank" rel="noopener noreferrer" href="${escapar(carrera.calUrl)}">Añadir al calendario</a><a target="_blank" rel="noopener noreferrer" href="${escapar(carrera.waUrl)}">Compartir</a></span>`);
            return { marker, punto, slug: carrera.slug };
          });

          const encuadrar = (lista) => {
            if (lista.length === 1) map.setView(lista[0], 12);
            else if (lista.length > 1) map.fitBounds(lista, { padding: [36, 36], maxZoom: 11 });
          };
          encuadrar(puntos.map((p) => p.punto));

          window.__mapaCarreras = {
            // slugsVisibles: Set con las carreras que siguen en la lista tras filtrar
            filtrar: (slugsVisibles) => {
              const visibles = [];
              puntos.forEach(({ marker, punto, slug }) => {
                if (slugsVisibles.has(slug)) { marker.addTo(map); visibles.push(punto); }
                else marker.remove();
              });
              encuadrar(visibles);
            },
            enfocar: (slug) => {
              const destino = puntos.find((p) => p.slug === slug);
              if (!destino) return;
              destino.marker.addTo(map);
              map.flyTo(destino.punto, 13, { duration: 0.8 });
              setTimeout(() => destino.marker.openPopup(), 450);
            }
          };
        </script>
      </>
    )}

    <script>
      declare global { interface Window { __mapaCarreras?: { filtrar: (slugs: Set<string>) => void; enfocar: (slug: string) => void } } }

      // --- Buscador y filtros del calendario ---
      const filtros = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
      const carreras = document.querySelectorAll<HTMLElement>('.carrera');
      const mesesLista = document.querySelectorAll<HTMLElement>('.mes');
      const buscador = document.querySelector<HTMLInputElement>('#buscar');
      const filtroModalidad = document.querySelector<HTMLSelectElement>('#filtro-modalidad');
      const filtroDistancia = document.querySelector<HTMLSelectElement>('#filtro-distancia');
      const sinResultados = document.querySelector<HTMLElement>('#sin-resultados');
      const resultado = document.querySelector<HTMLElement>('#resultado');
      let filtroActivo = 'all';

      const normalizar = (valor: string) => valor.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

      const cumpleFiltro = (fecha: string, filtro: string) => {
        if (filtro === 'all') return true;
        if (!fecha) return false;
        if (/^\d{4}-\d{2}$/.test(filtro)) return fecha.startsWith(filtro);

        const [a, m, d] = fecha.split('-').map(Number);
        const dia = new Date(a, m - 1, d);
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);
        const dentroDe = (dias: number) => new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + dias, 23, 59, 59);

        if (filtro === 'weekend') {
          // De viernes a domingo; si ya es fin de semana, desde hoy
          const semana = hoy.getDay();
          const esFinde = semana === 6 || semana === 0;
          const inicio = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() + (esFinde ? 0 : (5 - semana + 7) % 7));
          return dia >= inicio && dia <= dentroDe((7 - semana) % 7);
        }
        if (filtro === '15days') return dia >= hoy && dia <= dentroDe(15);
        if (filtro === '30days') return dia >= hoy && dia <= dentroDe(30);
        return false;
      };

      // Alguna de las pruebas de la carrera cae en el tramo elegido ('5-10': más de 5 y hasta 10 km)
      const cumpleDistancia = (kms: string, tramo: string) => {
        if (!tramo) return true;
        const [desde, hasta] = tramo.split('-').map(Number);
        return kms.split(',').filter(Boolean).map(Number).some((km) => km > desde && km <= hasta);
      };

      const actualizarLista = () => {
        const consulta = normalizar(buscador?.value.trim() || '');
        const modalidad = filtroModalidad?.value || '';
        const tramo = filtroDistancia?.value || '';
        const visibles = new Set<string>();
        let total = 0;
        carreras.forEach((carrera) => {
          const mostrar = cumpleFiltro(carrera.dataset.fecha || '', filtroActivo)
            && (!consulta || normalizar(carrera.dataset.buscar || '').includes(consulta))
            && (!modalidad || carrera.dataset.modalidad === modalidad)
            && cumpleDistancia(carrera.dataset.kms || '', tramo);
          carrera.hidden = !mostrar;
          if (mostrar) { total++; visibles.add(carrera.dataset.slug || ''); }
        });
        mesesLista.forEach((mes) => { mes.hidden = !mes.querySelector('.carrera:not([hidden])'); });
        if (sinResultados) sinResultados.hidden = total !== 0 || carreras.length === 0;
        if (resultado) resultado.textContent = `${total} ${total === 1 ? 'carrera' : 'carreras'}`;
        window.__mapaCarreras?.filtrar(visibles);
      };

      filtros.forEach((boton) => boton.addEventListener('click', () => {
        filtros.forEach((otro) => otro.setAttribute('aria-pressed', String(otro === boton)));
        filtroActivo = boton.dataset.filtro || 'all';
        actualizarLista();
      }));
      buscador?.addEventListener('input', actualizarLista);
      filtroModalidad?.addEventListener('change', actualizarLista);
      filtroDistancia?.addEventListener('change', actualizarLista);

      document.querySelectorAll<HTMLElement>('[data-localizar]').forEach((boton) => boton.addEventListener('click', () => {
        document.querySelector('#mapa')?.scrollIntoView({ behavior: 'smooth' });
        window.__mapaCarreras?.enfocar(boton.dataset.localizar || '');
      }));

      // --- Calculadora de ritmos ---
      const distancias = document.querySelectorAll<HTMLButtonElement>('[data-dist]');
      const otraDistancia = document.getElementById('otra-distancia');
      const kmLibres = document.getElementById('km-libres') as HTMLInputElement | null;
      const campos = ['t-horas', 't-min', 't-seg'].map((id) => document.getElementById(id) as HTMLInputElement | null);
      const ritmoKm = document.getElementById('ritmo-km');
      const ritmoVel = document.getElementById('ritmo-vel');
      const pasosCuerpo = document.getElementById('pasos-cuerpo');
      let distancia: number | 'custom' = 10;

      const dosCifras = (n: number) => String(n).padStart(2, '0');
      const formatoTiempo = (segundos: number) => {
        const total = Math.round(segundos);
        const h = Math.floor(total / 3600), m = Math.floor((total % 3600) / 60), s = total % 60;
        return h > 0 ? `${h} h ${dosCifras(m)} min ${dosCifras(s)} s` : `${m} min ${dosCifras(s)} s`;
      };
      const formatoRitmo = (segundosKm: number) => {
